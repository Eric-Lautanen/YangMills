5 |         wilsonActionOSNegative N T L β (U_ext cfg) +\n1326 |         wilsonActionOSInterface N T L β (U_ext cfg) := by\n1327 |     intro cfg\n1328 |     calc\n1329 |       S_total cfg = wilsonActionFinite N β (Finset.univ : Finset (PeriodicSite T L)) (U_ext cfg) := rfl\n1330 |       _ = wilsonActionOSPositive N T L β (U_ext cfg) +\n1331 |           wilsonActionOSNegative N T L β (U_ext cfg) +\n1332 |           wilsonActionOSInterface N T L β (U_ext cfg) :=\n1333 |         total_decomposition_os_periodic N T L β (U_ext cfg)\n1334 |   have h_neg_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1335 |       wilsonActionOSNegative N T L β (U_ext cfg) =\n1336 |       wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg)) := by\n1337 |     intro cfg\n1338 |     exact neg_action_reflection_os_periodic N T L β hT (U_ext cfg)\n1339 |   have h_int_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1340 |       wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) =\n1341 |       wilsonActionOSInterface N T L β (U_ext cfg) := by\n1342 |     intro cfg\n1343 |     exact interface_action_reflection_symmetric_os_periodic N T L β hT (U_ext cfg)\n1344 |   have h_factorization : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1345 |       Real.exp (-β * S_total cfg) = \n1346 |       (Real.exp (-β * wilsonActionOSPositive N T L β (U_ext cfg)) *\n1347 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) *\n1348 |       (Real.exp (-β * wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg))) *\n1349 |         Real.exp (-β * wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) / 2)) := by\n1350 |     intro cfg\n1351 |     rw [h_total_decomp cfg]\n1352 |     have h_mul : -β * (wilsonActionOSPositive N T L β (U_ext cfg) + wilsonActionOSNegative N T L β (U_ext cfg) +\n1353 |       wilsonActionOSInterface N T L β (U_ext cfg)) = \n1354 |       (-β * wilsonActionOSPositive N T L β (U_ext cfg)) + \n1355 |       (-β * wilsonActionOSNegative N T L β (U_ext cfg)) + \n1356 |       (-β * wilsonActionOSInterface N T L β (U_ext cfg)) := by ring\n1357 |     rw [h_mul]\n1358 |     rw [Real.exp_add, Real.exp_add]\n1359 |     rw [h_neg_reflect cfg, h_int_reflect cfg]\n1360 |     have h_exp_split : Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n1361 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n1362 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by\n1363 |       calc\n1364 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n1365 |           Real.exp ((-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) +\n1366 |                    (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) := by ring\n1367 |         _ = Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n1368 |             Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by rw [Real.exp_add]\n1369 |     rw [h_exp_split]\n1370 |     ring\n1371 |   set G := λ (U : LinkVariable (SU N) (PeriodicSite T L)) =>\n1372 |     f U * Real.exp (-β * wilsonActionOSPositive N T L β U) *\n1373 |     Real.exp (-β * wilsonActionOSInterface N T L β U / 2) with hG\n1374 |   have h_integrand_eq : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1375 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) *\n1376 |       Real.exp (-β * S_total cfg) =\n1377 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) := by\n1378 |     intro cfg\n1379 |     dsimp [G]\n1380 |     rw [h_factorization cfg]\n1381 |     ring\n1382 |   have h_fun_eq : (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1383 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg)) =\n1384 |     (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1385 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg))) := by\n1386 |     ext cfg; exact h_integrand_eq cfg\n1387 |   calc\n1388 |     (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1389 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg) ∂ μ₀)\n1390 |         = (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1391 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) ∂ μ₀) := by\n1392 |       rw [h_fun_eq]\n1393 |     _ ≥ 0 := by\n1394 |       -- GOAL: Prove that ∫ G(U)·G(θU) dμ₀(U) ≥ 0.\n1395 |       --\n1396 |       -- This is the core of the Osterwalder–Seiler reflection positivity proof.\n1397 |       -- The integrand G·θG is NOT pointwise non-negative; the non-negativity\n1398 |       -- holds only after integration with respect to the product Haar measure.\n1399 |       --\n1400 |       -- MATHEMATICAL ARGUMENT (Osterwalder–Seiler 1979, §3):\n1401 |       --\n1402 |       -- The product Haar measure μ₀ on the finite periodic lattice factorises\n1403 |       -- as μ₀ = μ⁺ ⊗ μ⁻ ⊗ μ⁰, where μ⁺/μ⁻/μ⁰ are the Haar measures on links\n1404 |       -- in the positive-time, negative-time, and interface regions respectively.\n1405 |       --\n1406 |       -- Define the transfer matrix T acting on L²(μ⁺ ⊗ μ⁰) by:\n1407 |       --\n1408 |       --   (Tψ)(U⁺, U⁰) = ∫ ψ(U⁻, U⁰) · exp(-β · S_OS_int(U⁺, U⁻, U⁰)) dμ⁻(U⁻)\n1409 |       --\n1410 |       -- where S_OS_int is the interface part of the Wilson action.  The key\n1411 |       -- identity (proved algebraically above) is:\n1412 |       --\n1413 |       --   ∫ G(U)·G(θU) dμ₀(U) = ⟨G⁺, T·G⁺⟩_{L²(μ⁺ ⊗ μ⁰)}\n1414 |       --\n1415 |       -- where G⁺ is the restriction of G to variables in the positive-time and\n1416 |       -- interface regions.  The operator T is POSITIVE because the integral kernel\n1417 |       -- K(U⁺, U⁻, U⁰) = exp(-β · S_OS_int(U⁺, U⁻, U⁰)) is a positive-definite\n1418 |       -- function on (SU(N)ⁿ × SU(N)ⁿ).  This follows from the Peter–Weyl theorem\n1419 |       -- on SU(N): the matrix elements of the unitary irreducible representations\n1420 |       -- form an orthonormal basis of L²(SU(N)), and the Boltzmann factor expands\n1421 |       -- as a sum of squares in this basis (OS 1979, Theorem 3.1).\n1422 |       --\n1423 |       -- Consequently, ⟨G⁺, T·G⁺⟩ ≥ 0, and the integral is non-negative.\n1424 |       --\n1425 |       -- FORMALIZATION STATUS:\n1426 |       --\n1427 |       -- The Peter–Weyl theorem for SU(N) (or more generally for compact Lie groups)\n1428 |       -- is not yet available in Mathlib.  The spectral theory of compact integral\n1429 |       -- operators on L² is also not yet formalised.  Filling this gap requires:\n1430 |       --\n1431 |       --   1. The Peter–Weyl theorem: L²(SU(N)) ≅ ⊕_{λ} V_λ ⊗ V_λ^* (as\n1432 |       --      SU(N)×SU(N)-representations), where λ runs over dominant weights.\n1433 |       --   2. The Bochner–Minlos theorem or its Lie-group analogue: positive-definite\n1434 |       --      functions correspond to measures / states on the group C*-algebra.\n1435 |       --   3. Positivity of the transfer matrix T constructed from the Wilson\n1436 |       --      interface action.\n1437 |       --\n1438 |       -- REFERENCES:\n1439 |       --   - K. Osterwalder, E. Seiler, \"Gauge Field Theories on a Lattice\"\n1440 |       --     (Ann. Phys. 110, 1978, pp 440–471), §3.\n1441 |       --   - J. Glimm, A. Jaffe, \"Quantum Physics\" (2nd ed.), §6.1.\n1442 |       --   - M. Salmhofer, \"Construction of a Higgs field\" (thesis, 1990).\n1443 |       --\n1444 |       -- Until these results are available in Mathlib, the last step remains\n1445 |       -- an open `sorry`.  The rest of the reflection positivity proof (all\n1446 |       -- algebraic identities, the action decomposition, and the reduction\n1447 |       -- to the integral of G·θG) is fully formalised.\n1448 |       sorry\n1449 | end OSDecomposition\n1450 | /--\n1451 | The `PeriodicExpectation` structure for the SU(N) Wilson action on a finite periodic lattice.\n1452 | This provides a reflection positivity certificate that does NOT require the `hadd` hypothesis,\n1453 | because periodic boundary conditions make the lattice closed under forward time translation.\n1454 | -/\n1455 | structure PeriodicExpectation (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hT : Odd T) : Type 1 where\n1456 |   /-- The partition function Z = ∫ exp(-S_W) dU. -/\n1457 |   partitionFunction : ℝ\n1458 |   /-- Positivity of the partition function: Z > 0 for β > 0. -/\n1459 |   partitionFunctionPos : partitionFunction > 0\n1460 |   /-- The expectation of an observable F. -/\n1461 |   evaluate : (LinkVariable (SU N) (PeriodicSite T L) → ℝ) → ℝ\n1462 |   /-- Linearity of expectation. -/\n1463 |   linearity : ∀ (a b : ℝ) (F G : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1464 |     (MeasureTheory.Integrable (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1465 |       F (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n1466 |       Real.exp (-β * wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n1467 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)))) →\n1468 |     (MeasureTheory.Integrable (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1469 |       G (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n1470 |       Real.exp (-β * wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n1471 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)))) →\n1472 |     evaluate (λ U => a * F U + b * G U) = a * evaluate F + b * evaluate G\n1473 |   /-- Normalization: ⟨1⟩ = 1. -/\n1474 |   normalization : evaluate (λ _ => 1) = 1\n1475 |   /-- Positivity: if F ≥ 0 pointwise, then ⟨F⟩ ≥ 0. -/\n1476 |   positivity : ∀ (F : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1477 |     (∀ U, F U ≥ 0) → evaluate F ≥ 0\n1478 |   /-- Reflection positivity: ⟨f · θ(f)⟩ ≥ 0. -/\n1479 |   reflectionPositive : ∀ (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1480 |     evaluate (λ U => f U * reflectObservable N f U) ≥ 0\n1481 | \n1482 | /--\n1483 | Construct a `PeriodicExpectation` for the Wilson action on a finite periodic lattice.\n1484 | This uses the Osterwalder-Seiler factorization to prove reflection positivity without\n1485 | the `hadd` limitation of the Z4Site version.\n1486 | -/\n1487 | noncomputable def wilsonPeriodicExpectation (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hT : Odd T) :\n1488 |     PeriodicExpectation N T L β hT :=\n1489 |   {\n1490 |     partitionFunction := partitionFunctionFinite N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1491 |     partitionFunctionPos := partitionFunctionFinite_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1492 |     evaluate := gibbsExpectation N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1493 |     linearity := λ a b F G hF hG =>\n1494 |       gibbsExpectation_linear N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) a b F G hF hG\n1495 |     normalization := gibbsExpectation_normalization N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1496 |     positivity := λ F hF => gibbsExpectation_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) F hF\n1497 |     reflectionPositive := λ f =>\n1498 |       gibbsExpectationPeriodic_reflection_positive N T L β hT f\n1499 |   }\n1500 | /--\n1501 | The SU(N) lattice Yang-Mills measure with the Wilson action on a finite periodic lattice\n1502 | is reflection positive. This theorem does NOT require the `hadd` hypothesis, because the\n1503 | periodic boundary conditions make `addVector` closed on the full lattice automatically.\n1504 | -/\n1505 | theorem lattice_ym_reflection_positive_periodic (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hβ : β > 0) (hT : Odd T) :\n1506 |     ∀ (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1507 |       (wilsonPeriodicExpectation N T L β hT).evaluate (λ U => f U * reflectObservable N f U) ≥ 0 := by\n1508 |   intro f\n1509 |   exact (wilsonPeriodicExpectation N T L β hT).reflectionPositive f\n1510 | \n1511 | end PeriodicSite\n\n---\npath:C:\\github\\YangMills\\src\\lean\\YangMills\\Overview.lean\n-- 92 lines, 5207 bytes --\n 1 | /-\n 2 | # Overview\n 3 | \n 4 | Project structure, references, and current status for the Yang-Mills\n 5 | formalization effort.\n 6 | \n 7 | ## Current Status (Phase 6: Periodic boundary conditions — genuine reflection positivity proof)\n 8 | \n 9 | ### Completed (Phase 3):\n10 | - SU(N) defined via Mathlib's `Matrix.specialUnitaryGroup` (SpecialUnitary.lean)\n11 | - su(N) Lie algebra as skew-Hermitian traceless matrices (SpecialUnitary.lean)\n12 | - CompactSpace (SU N) proved (SpecialUnitary.lean)\n13 | - Principal G-bundles, connections, curvature (GaugeTheory.lean)\n14 | - Yang-Mills action functional (GaugeTheory.lean)\n15 | - Lattice gauge theory foundations (Lattice.lean)\n16 | - OS Axioms skeleton (OSAxioms.lean)\n17 | - Mass Gap definition (MassGap.lean)\n18 | \n19 | ### Completed (Phase 4 — Z4Site combinatorial lemmas):\n20 | - **reflectSite_involution**: reflectSite ∘ reflectSite = id\n21 | - **plaquette_product_reflection_spatial**: plaquette product reflection for spatial μ,ν\n22 | - **trace_plaquette_product_reflection**: trace equality for ALL (μ,ν) cases including time-involving\n23 | - **neg_action_reflection_z4**: S_W⁻[U] = S_W⁺[θU] (with hadd hypothesis)\n24 | - **interface_action_reflection_symmetric_z4**: S_W⁰[θU] = S_W⁰[U] (with hadd hypothesis)\n25 | - **reflectTriple_preserves_interface**: reflection maps interface plaquettes to interface plaquettes\n26 | - **total_wilson_action_decomposition_z4**: S_W = S_W⁺ + S_W⁻ + S_W⁰\n27 | - **wilsonActionFiniteConfig_reflection_invariant**: S_W[θU] = S_W[U]\n28 | - **extend_reflectFiniteConfig_eq**: extending reflected config = reflecting extended config\n29 | \n30 | ### Completed (Phase 5 — Measure-theoretic formalization):\n31 | - **productHaarMeasure**: product Haar measure on finite lattice via Measure.pi\n32 | - **MeasurableSpace on LinkVariable**: via MeasurableSpace.comap on value projection\n33 | - **IsProbabilityMeasure**: total volume = 1 (proved)\n34 | - **partitionFunctionFinite_pos**: > 0 for any sites (including nonempty)\n35 | - **gibbsExpectation_pos**: expectation of non-negative observable is ≥ 0\n36 | - **gibbsExpectation_normalization**: ⟨1⟩ = 1\n37 | - **gibbsExpectation_linear**: linearity of expectation with integrability hypotheses\n38 | - **gibbsExpectationZ4_reflection_positive**: proved (vacuous for nonempty due to hadd)\n39 | - **measurable_extendLinkVariable**: extension map is measurable\n40 | - **measurable_wilsonActionFiniteConfig**: Wilson action is measurable (continuous on compact)\n41 | \n42 | ### Completed (Phase 6 — Periodic BCs, Osterwalder-Seiler decomposition):\n43 | - **PeriodicSite**: finite lattice with ZMod time and spatial coordinates\n44 | - **addVectorPeriodic, reflectSitePeriodic**: modular arithmetic for periodic BCs\n45 | - **signedTime**: signed lift of ZMod T to ℤ, enabling time-ordered decomposition\n46 | - **positiveSites, negativeSites, interfaceSites**: time-slice partitioning\n47 | - **wilsonActionOSPositive/Negative/Interface**: OS plaquette-based decomposition\n48 | - **plaquette_classification**: every plaquette is positive, negative, or interface\n49 | - **total_decomposition_os_periodic**: S_W = S_OS⁺ + S_OS⁻ + S_OS_int\n50 | - **reflectPlaquetteIndex_sign**: reflection flips positive ↔ negative plaquettes\n51 | - **plaquettePositive/Negative**: predicates for OS classification\n52 | - **reflectPlaquetteIndex**: involutive bijection on PlaquetteIndex\n53 | - **trace_plaquetteProduct_reflect_all**: unconditional trace equality for all (μ,ν)\n54 | - **plaquetteContribution_reflect_eq_all**: unconditional contribution equality\n55 | - **neg_action_reflection_os_periodic**: S_OS⁻[U] = S_OS⁺[θU] via Fintype.sum_equiv\n56 | - **interface_action_reflection_symmetric_os_periodic**: S_OS_int[θU] = S_OS_int[U]\n57 | - **gibbsExpectationPeriodic_reflection_positive**: all algebraic steps complete,\n58 |   reduction to ∫ G·θG dμ₀ ≥ 0 proved. Final positivity depends on the\n59 |   Peter–Weyl theorem on SU(N) (transfer matrix argument) — one `sorry` remains.\n60 | \n61 | ### Remaining (1 sorry item):\n62 | - **gibbsExpectationPeriodic_reflection_positive**: ∫ G·θG dμ₀ ≥ 0 requires the\n63 |   transfer matrix positivity argument (Osterwalder-Seiler 1979, §3). This needs\n64 |   the Peter–Weyl theorem on SU(N) or spectral theory of compact operators on\n65 |   L²(SU(N)). See the comment in ReflectionPositivity.lean for full details.\n66 | \n67 | ### Future work:\n68 | - Complete the transfer matrix positivity proof (Peter–Weyl theorem)\n69 | - Construct the `PeriodicExpectation` structure (defined but uses `sorry`)\n70 | - Continuum limit (Balaban renormalization group)\n71 | - OS reconstruction theorem (Euclidean → Minkowski reconstruction)\n72 | - Mass gap proof (positivity and exponential decay)\n73 | \n74 | ## References\n75 | \n76 | - A. Jaffe, E. Witten, \"Quantum Yang-Mills Theory\" (Clay Millennium Problem)\n77 | - R. Streater, A. Wightman, \"PCT, Spin and Statistics, and All That\"\n78 | - J. Glimm, A. Jaffe, \"Quantum Physics: A Functional Integral Point of View\"\n79 | - K. Osterwalder, R. Schrader, \"Axioms for Euclidean Green's Functions\"\n80 | - K. Osterwalder, E. Seiler, \"Gauge Field Theories on a Lattice\" (1979)\n81 | - T. Balaban, \"Renormalization group approach to lattice gauge field theories\"\n82 | - M. Hairer, \"A theory of regularity structures\"\n83 | - S. Chatterjee, \"Yang-Mills for probabilists\"\n84 | - K. Wilson, \"Confinement of quarks\"\n85 | -/\n86 | \n87 | namespace YangMills\n88 | \n89 | def description : String :=\n90 |   \"Formalization of Yang-Mills existence and mass gap problem (Clay Millennium Prize)\"\n91 | \n92 | end YangMills\n\n---\npath:C:\\github\\YangMills\\docs\\hadd_issue.md\n-- 87 lines, 4305 bytes --\n 1 | # Architectural Issue: `hadd` Hypothesis (Resolved)\n 2 | \n 3 | ## Problem (Historical)\n 4 | \n 5 | The `gibbsExpectationZ4_reflection_positive` lemma in `LatticeMeasure.lean` had the hypothesis:\n 6 | \n 7 | ```lean\n 8 | hadd : ∀ n, n ∈ sites → addVector n 0 ∈ sites\n 9 | ```\n10 | \n11 | This requires the finite lattice `sites` to be **closed under forward time translation**:\n12 | if a site `n` is in the lattice, then `n + e₀` (the time-forward neighbor) must also be in the lattice.\n13 | \n14 | ## Why This Was Problematic\n15 | \n16 | For a **finite** set `sites : Finset Z4Site`, this closure condition forces `sites = ∅`:\n17 | \n18 | 1. If `sites` is nonempty, take the site `n` with maximum time coordinate `m = n.1`.\n19 | 2. By `hadd`, `addVector n 0 ∈ sites`, and `(addVector n 0).1 = n.1 + 1 = m + 1`.\n20 | 3. But `m` is the maximum time coordinate, so `m + 1 ≤ m`, a contradiction.\n21 | \n22 | The old proof of `gibbsExpectationZ4_reflection_positive` exploited exactly this: the nonempty case\n23 | derives a contradiction, so the theorem was only non-vacuously useful for `sites = ∅`.\n24 | \n25 | ## Resolution: Periodic Boundary Conditions\n26 | \n27 | The fix was to replace the infinite lattice `Z4Site = ℤ⁴` with a periodic lattice\n28 | `PeriodicSite T L = ZMod T × ZMod L × ZMod L × ZMod L` (defined in `Lattice.lean`).\n29 | \n30 | In this setting:\n31 | - **`addVector`** wraps around modulo `T`/`L` automatically via ZMod addition, making the lattice\n32 |   closed under forward time translation for **any** finite set of sites (in particular, `Finset.univ`).\n33 | - **`reflectSite`** maps time `t ↦ -t` (mod T), which is involutive.\n34 | - The `hadd` hypothesis is no longer needed because we always work with the full lattice\n35 |   `Finset.univ`, which is trivially closed.\n36 | \n37 | ## Current Status\n38 | \n39 | The periodic boundary condition approach is fully implemented in `ReflectionPositivity.lean`:\n40 | \n41 | 1. **PeriodicSite** structure with `addVectorPeriodic` and `reflectSitePeriodic` (Lattice.lean)\n42 | 2. **OS decomposition**: `wilsonActionOSPositive`, `wilsonActionOSNegative`, `wilsonActionOSInterface`\n43 |    — decomposing the Wilson action into positive-time, negative-time, and interface parts.\n44 | 3. **Algebraic lemmas proved**:\n45 |    - `total_decomposition_os_periodic`: S_W = S_OS⁺ + S_OS⁻ + S_OS_int\n46 |    - `neg_action_reflection_os_periodic`: S_OS⁻[U] = S_OS⁺[θU]\n47 |    - `interface_action_reflection_symmetric_os_periodic`: S_OS_int[θU] = S_OS_int[U]\n48 |    - `trace_plaquetteProduct_reflect_all`: trace equality for all plaquettes\n49 |    - `plaquetteContribution_reflect_eq_all`: contribution equality for all plaquettes\n50 | 4. **Gibbs expectation proof**: `gibbsExpectationPeriodic_reflection_positive` reduces\n51 |    the reflection positivity condition to ∫ G·θG dμ₀ ≥ 0 (all algebraic steps completed).\n52 | 5. **One remaining `sorry`**: The final positivity ∫ G·θG dμ₀ ≥ 0 requires the\n53 |    Peter–Weyl theorem on SU(N) (transfer matrix argument, Osterwalder-Seiler 1979, §3).\n54 |    See `ReflectionPositivity.lean` for details.\n55 | \n56 | ## Impact\n57 | \n58 | - The old `Z4Expectation` structure and `wilsonZ4Expectation` are deprecated in favor of\n59 |   `PeriodicExpectation` and `wilsonPeriodicExpectation`.\n60 | - The `hadd` hypothesis is no longer required for the reflection positivity proof.\n61 | - The `lattice_ym_reflection_positive_periodic` theorem provides a genuine reflection positivity\n62 |   certificate for the Wilson action on periodic lattices, modulo the transfer matrix positivity step.\n63 | \n64 | ## Old Fix Options (for reference)\n65 | \n66 | ### Option B: Remove `hadd`\n67 | \n68 | Prove reflection positivity without the closure hypothesis. The `hadd` hypothesis is used in:\n69 | - The decomposition lemmas (to ensure reflected plaquette sites remain in the lattice)\n70 | - Transitive closure arguments\n71 | \n72 | Without `hadd`, these lemmas need to handle plaquettes whose reflected corners fall outside\n73 | the lattice. This requires either:\n74 | - Restricting to lattices that are reflection-invariant (`hsites` already provides this)\n75 | - Handling boundary plaquettes separately\n76 | \n77 | **Implementation complexity**: Medium. Would require a different proof approach that works\n78 | with boundaries.\n79 | \n80 | ### Option C: Infinite Lattice\n81 | \n82 | Work with an infinite lattice (no `Finset` constraint on `sites`). This avoids the finiteness\n83 | issue but requires more measure-theoretic infrastructure (infinite product measures,\n84 | σ-finiteness, etc.).\n85 | \n86 | **Implementation complexity**: High. Requires significant additional measure theory\n87 | infrastructure.\n\n---\n","timestamp":1783960245,"token_count":14498,"tool_call_id":"call_00_uTQK4uEPuoIGbNAzUMkX4089","full_token_estimate":10517,"tool_meta":{"tool_name":"read_files","file_path":"src/lean/YangMills/Proofs/ReflectionPositivity.lean, src/lean/YangMills/Overview.lean, docs/hadd_issue.md","old_text":null,"new_text":null,"exit_code":null,"line_count":798,"byte_count":47676,"is_error":false,"duration_ms":1,"edit_line":null},"turn":3,"is_prune_marker":false}
