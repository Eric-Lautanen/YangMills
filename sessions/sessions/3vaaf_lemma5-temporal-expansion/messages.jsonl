6 | (plaquette-based OS decomposition):\n497 |     S_W = S_OS⁺ + S_OS⁻ + S_OS_int\n498 | -/\n499 | lemma total_decomposition_os_periodic (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L]\n500 |     (U : LinkVariable (SU N) (PeriodicSite T L)) :\n501 |     wilsonActionFinite N β (Finset.univ : Finset (PeriodicSite T L)) U =\n502 |     wilsonActionOSPositive N T L β U +\n503 |     wilsonActionOSNegative N T L β U +\n504 |     wilsonActionOSInterface N T L β U := by\n505 |   unfold wilsonActionOSPositive wilsonActionOSNegative wilsonActionOSInterface wilsonActionFinite\n506 |   have h_split (n : PeriodicSite T L) (μ ν : Fin 4) : plaquetteContribution N β U n μ ν =\n507 |     (if signedTime T n.time > 0 ∧ signedTime T (addVectorPeriodic T L n μ).time > 0 ∧\n508 |          signedTime T (addVectorPeriodic T L (addVectorPeriodic T L n μ) ν).time > 0 ∧\n509 |          signedTime T (addVectorPeriodic T L n ν).time > 0 then\n510 |       plaquetteContribution N β U n μ ν else 0) +\n511 |     (if signedTime T n.time < 0 ∧ signedTime T (addVectorPeriodic T L n μ).time < 0 ∧\n512 |          signedTime T (addVectorPeriodic T L (addVectorPeriodic T L n μ) ν).time < 0 ∧\n513 |          signedTime T (addVectorPeriodic T L n ν).time < 0 then\n514 |       plaquetteContribution N β U n μ ν else 0) +\n515 |     (if ¬ (signedTime T n.time > 0 ∧ signedTime T (addVectorPeriodic T L n μ).time > 0 ∧\n516 |           signedTime T (addVectorPeriodic T L (addVectorPeriodic T L n μ) ν).time > 0 ∧\n517 |           signedTime T (addVectorPeriodic T L n ν).time > 0) ∧\n518 |        ¬ (signedTime T n.time < 0 ∧ signedTime T (addVectorPeriodic T L n μ).time < 0 ∧\n519 |           signedTime T (addVectorPeriodic T L (addVectorPeriodic T L n μ) ν).time < 0 ∧\n\n... 2099 more line(s) below (use offset=520 to continue reading)\nTime: 2026-08-05 08:18:10 UTC","timestamp":1785917890,"token_count":1780,"tool_call_id":"b75e0e56-5667-464a-93a8-1f1e474ca011","full_token_estimate":1181,"tool_meta":{"tool_name":"read_fil