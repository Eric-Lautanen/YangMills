p then plaquetteContribution N β (reflectLinkVariable N U) p.1 p.2.1 p.2.2 else 0)\n2328 |   let g : PlaquetteIndex T L → ℝ := λ p =>\n2329 |     (if ¬ plaquettePositive T L p ∧ ¬ plaquetteNegative T L p then plaquetteContribution N β U p.1 p.2.1 p.2.2 else 0)\n2330 |   let e : PlaquetteIndex T L ≃ PlaquetteIndex T L := reflectPlaquetteIndexEquiv T L\n2331 |   have h_interface_inv (p : PlaquetteIndex T L) : \n2332 |       (¬ plaquettePositive T L (reflectPlaquetteIndex T L p) ∧ ¬ plaquetteNegative T L (reflectPlaquetteIndex T L p)) ↔\n2333 |       (¬ plaquettePositive T L p ∧ ¬ plaquetteNegative T L p) := by\n2334 |     have h1 := reflectPlaquetteIndex_sign T L hT p\n2335 |     have h2 : plaquetteNegative T L (reflectPlaquetteIndex T L p) ↔ plaquettePositive T L p := by\n2336 |       have h_inv : reflectPlaquetteIndex T L (reflectPlaquetteIndex T L p) = p :=\n2337 |         reflectPlaquetteIndex_involution T L p\n2338 |       have h' := reflectPlaquetteIndex_sign T L hT (reflectPlaquetteIndex T L p)\n2339 |       simpa [h_inv] using h'.symm\n2340 |     constructor\n2341 |     · rintro ⟨hnpos, hnneg⟩\n2342 |       constructor\n2343 |       · exact mt h2.symm.mp hnneg\n2344 |       · exact mt h1.symm.mp hnpos\n2345 |     · rintro ⟨hnpos, hnneg⟩\n2346 |       constructor\n2347 |       · exact mt h1.mp hnneg\n2348 |       · exact mt h2.mp hnpos\n2349 |   have h_eq (p : PlaquetteIndex T L) : f (e p) = g p := by\n2350 |     have h_e_val : e p = reflectPlaquetteIndex T L p := rfl\n2351 |     rw [h_e_val]\n2352 |     have h_cond : ¬ plaquettePositive T L (reflectPlaquetteIndex T L p) ∧ ¬ plaquetteNegative T L (reflectPlaquetteIndex T L p) ↔\n2353 |       ¬ plaquettePositive T L p ∧ ¬ plaquetteNegative T L p := h_interface_inv p\n2354 |     dsimp [f, g]\n2355 |     by_cases hi : (¬ plaquettePositive T L p ∧ ¬ plaquetteNegative T L p)\n2356 |     · rw [if_pos hi, if_pos ((h_interface_inv p).mpr hi)]\n2357 |       rw [← plaquetteContribution_reflect_eq_all N T L β U p]\n2358 |     · rw [if_neg hi, if_neg (mt (h_interface_inv p).mp hi)]\n2359 |   calc\n2360 |     ∑ p : PlaquetteIndex T L, f p = ∑ p : PlaquetteIndex T L, f (e p) := by\n2361 |       symm\n2362 |       exact Fintype.sum_equiv e (λ p => f (e p)) f (λ p => rfl)\n2363 |     _ = ∑ p : PlaquetteIndex T L, g p := by\n2364 |       refine Finset.sum_congr rfl (λ p hp => ?_)\n2365 |       rw [h_eq p]\n2366 | /-- The Osterwalder-Seiler \"G\" function: the Boltzmann factor for the positive\n2367 | half-lattice, including the interface action at half weight.  This is the\n2368 | function whose integral `∫ G(U)·G(θU) dμ₀` must be shown non-negative. -/\n2369 | noncomputable def osG (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L]\n2370 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n2371 |     (U : LinkVariable (SU N) (PeriodicSite T L)) : ℝ :=\n2372 |   f U * Real.exp (-β * wilsonActionOSPositive N T L β U) *\n2373 |   Real.exp (-β * wilsonActionOSInterface N T L β U / 2)\n2374 | \n2375 | /-- **Axiom (Transfer-matrix positivity).**\n2376 | \n2377 | For `f` depending only on positive-time and interface links, the integral\n2378 | `∫ G(U)·G(θU) dμ₀ ≥ 0`, where `G = osG` is the Osterwalder-Seiler Boltzmann\n2379 | factor and `θ` is the time-reflection.\n2380 | \n2381 | This is the positivity of the transfer matrix `T` constructed from the\n2382 | plaquette Boltzmann factor.  The mathematical justification is:\n2383 | \n2384 | 1. The plaquette Boltzmann factor `exp(c·Re Tr(g₁g₂g₃g₄))` is a\n2385 |    positive-definite function on `SU(N)⁴` — this is proved (from the\n2386 |    Peter-Weyl / Clebsch-Gordan axiom) in `PeterWeyl.lean` as\n2387 |    `plaquetteBoltzmannPD`.\n2388 | 2. Positive-definiteness of the plaquette factor implies that the transfer\n2389 |    matrix `T` (which integrates out the negative-time links with the\n2390 |    reflection kernel) is a positive operator on `L²(SU(N)^{interface})`.\n2391 | 3. The identity `∫ G(U)·G(θU) dμ₀ = ∫ g(u)·(Tg)(u) dμ⁺⁰` (proved in\n2392 |    `TransferMatrix.lean` as `integral_G_thetaG_eq_inner_g_Tg`) then gives\n2393 |    `∫ G·G(θU) ≥ 0` from the positivity of `T`.\n2394 | \n2395 | Steps 2–3 require the full transfer-matrix construction (measure-theoretic\n2396 | factorization of the product Haar measure, Fubini, and the character-expansion\n2397 | argument).  The positive-definiteness of the plaquette factor (step 1) is the\n2398 | key input and is proved in `PeterWeyl.lean`; the remaining measure theory is\n2399 | axiomatized here.  See `docs/found_issues.md` §3 and `docs/gap_analysis.md`. -/\n2400 | axiom transferMatrixPositivity_axiom (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L]\n2401 |     (hT : Odd T) (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n2402 |     (hf_supported : dependsOnlyOnPosInterface N T L f) :\n2403 |     0 ≤ ∫ (cfg : FiniteLinkConfig N (PeriodicSite T L)\n2404 |         (Finset.univ : Finset (PeriodicSite T L))),\n2405 |       osG N T L β f\n2406 |         (extendLinkVariable N (PeriodicSite T L)\n2407 |           (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n2408 |       osG N T L β f\n2409 |         (reflectLinkVariable N\n2410 |           (extendLinkVariable N (PeriodicSite T L)\n2411 |             (Finset.univ : Finset (PeriodicSite T L)) cfg))\n2412 |       ∂ productHaarMeasure N (PeriodicSite T L)\n2413 |         (Finset.univ : Finset (PeriodicSite T L))\n2414 | \n2415 | lemma gibbsExpectationPeriodic_reflection_positive (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L]\n2416 |     (hT : Odd T) (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n2417 |     (hf_supported : dependsOnlyOnPosInterface N T L f) :\n2418 |     0 ≤ gibbsExpectation N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n2419 |       (λ U => f U * reflectObservable N f U) := by\n\n... 199 more line(s) below (use offset=2420 to continue reading)\nTime: 2026-08-05 07:47:14 UTC","timestamp":1785916034,"token_count":2403,"tool_call_id":"17304248-8aba-48a6-8454-19f961adcca0","full_token_estimate":158