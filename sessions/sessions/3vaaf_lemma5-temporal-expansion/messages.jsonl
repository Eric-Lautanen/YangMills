aceLinkInt T L, repCharacter (ρ (w l)) (interfaceLinkVar N T L U l)) *\n5674 |           star (∏ l ∈ interfaceLinkNeg T L, repCharacter (ρ (dual (w l))) (interfaceLinkVar N T L U l)))\n5675 |     (hψ_int : ∀ (u : PosInterfaceConfig N T L), Integrable\n5676 |       (fun (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) =>\n5677 |         ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n5678 |         Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n5679 |           osPositiveOfPosInterface N T L β\n5680 |             (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) / 2 +\n5681 |           wilsonActionOSInterface N T L β\n5682 |             (extendToFullConfig N T L (reflectPosToNeg N T L V_plus) u))))\n5683 |       (haarMeasurePositive N T L))\n5684 |     (h_int : ∀ w : InterfaceLink T L → ι,\n5685 |       Integrable (fun (x : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n5686 |           FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) =>\n5687 |         (F w : ℂ) *\n5688 |           (charFactorInt N T L ι dims ρ w x.2 *\n5689 |            fourierCoeffNeg N T L β ψ ι dims ρ dual w x.2) *\n5690 |           (Complex.ofReal (ψ (mergePosInterface N T L x.1 x.2) *\n5691 |             Real.exp (-β * osPositiveOfPosInterface N T L β (mergePosInterface N T L x.1 x.2) / 2)) *\n5692 |            charFactorPos N T L ι dims ρ w x.1))\n5693 |         ((haarMeasurePositive N T L).prod (haarMeasureInterface N T L))) :\n5694 |     Complex.ofReal (∫ (u : PosInterfaceConfig N T L),\n5695 |       ψ u * transferMatrixReflected N T L β ψ u ∂ haarMeasurePosInterface N T L) =\n5696 |     (C : ℂ) * ∑ w : InterfaceLink T L → ι, (F w : ℂ) *\n5697 |       ∫ (u0 : FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)),\n5698 |         charFactorInt N T L ι dims ρ w u0 *\n5699 |         fourierCoeffPos N T L β ψ ι dims ρ (fullReflectReindex T L hT ι dual w)\n