odAssoc.symm ∘ (f1 × id) ∘ f2\n405 |     exact h_f2_mp.comp (h_f1I_mp.comp h_assoc_mp)\n406 |   -- Clean up: replace local definitions with the original ones\n407 |   dsimp [posSites, negSites, intSites, A] at e he_mp\n408 |   dsimp [haarMeasurePositive, haarMeasureNegative, haarMeasureInterface]\n409 |   -- Use hAll_eq (All = Finset.univ) to rewrite the goal and finish\n410 |   rw [← hAll_eq]\n411 |   exact ⟨e, he_mp⟩\n412 | \n413 | /-- The configuration space for positive and interface links together. -/\n414 | abbrev PosInterfaceConfig :=\n415 |   FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L ∪ interfaceSites T L)\n416 | \n417 | /-- Restriction of a full configuration to the positive and interface links. -/\n418 | noncomputable def restrictPosInterface (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) :\n419 |     PosInterfaceConfig N T L :=\n420 |   λ idx => cfg ⟨(idx.1.1, idx.1.2), Finset.mem_univ (idx.1.1)⟩\n421 | \n422 | /-- Merging a positive configuration and an interface configuration. -/\n423 | noncomputable def mergePosInterface\n424 |     (U_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L))\n425 |     (U_zero : FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) :\n426 |     PosInterfaceConfig N T L :=\n427 |   λ idx =>\n428 |     match idx with\n429 |     | ⟨(n, μ), hmem⟩ =>\n430 |       if h : n ∈ positiveSites T L then\n431 |         U_plus ⟨(n, μ), h⟩\n432 |       else\n433 |         have hint : n ∈ interfaceSites T L := by\n434 |           rcases Finset.mem_union.mp hmem with (hpos | hint)\n435 |           · exact (h hpos).elim\n436 |           · exact hint\n437 |         U_zero ⟨(n, μ), hint⟩\n438 | \n439 | /-- The product Haar measure on the positive+interface configuration space. -/\n440 | noncomputable def haarMeasurePosInterface : Measure (PosInterfaceConfig N T L) :=\n441 |   Measure.map (Function.uncurry (mergePosInterface N T L))\n442 |     ((haarMeasurePositive N T L).prod (haarMeasureInterface N T L))\n443 | \n444 | lemma haarMeasurePosInterface_eq :\n445 |     haarMeasurePosInterface N T L =\n446 |     Measure.map (Function.uncurry (mergePosInterface N T L))\n447 |       ((haarMeasurePositive N T L).prod (haarMeasureInterface N T L)) := rfl\n448 | \n449 | /-- Merge a negative and a positive+interface configuration into a full config. -/\n450 | noncomputable def mergeConfigurations\n451 |     (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L))\n452 |     (U_plus_zero : PosInterfaceConfig N T L) :\n453 |     FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) :=\n454 |   λ idx =>\n455 |     match idx with\n456 |     | ⟨(n, μ), hn⟩ =>\n457 |       if hpos : n ∈ positiveSites T L then\n458 |         U_plus_zero ⟨(n, μ), Finset.mem_union_left (interfaceSites T L) hpos⟩\n459 |       else if hneg : n ∈ negativeSites T L then\n460 |         U_minus ⟨(n, μ), hneg⟩\n461 |       else\n462 |         have hint : n ∈ interfaceSites T L := by\n463 |           have h_cover : (positiveSites T L) ∪ (negativeSites T L) ∪ (interfaceSites T L) = Finset.univ := by\n464 |             ext n'; simp [positiveSites, negativeSites, interfaceSites]\n465 |             by_cases hpos' : signedTime T n'.time > 0\n466 |             · simp [hpos']\n467 |             · by_cases hneg' : signedTime T n'.time < 0\n468 |               · simp [hpos', hneg']\n469 |               · have hzero' : signedTime T n'.time = 0 := by\n470 |                   have hle' : signedTime T n'.time ≤ 0 := by linarith\n471 |                   have hge' : signedTime T n'.time ≥ 0 := by linarith\n472 |                   linarith\n473 |                 simp [hpos', hneg', hzero']\n474 |           have hn_univ : n ∈ Finset.univ := hn\n475 |           have h_mem : n ∈ (positiveSites T L) ∪ (negativeSites T L) ∪ (interfaceSites T L) := by\n476 |             rw [h_cover]; exact hn_univ\n477 |           rcases Finset.mem_union.mp h_mem with (h | h)\n478 |           · rcases Finset.mem_union.mp h with (h' | h')\n479 |             · exfalso; exact hpos h'\n480 |             · exfalso; exact hneg h'\n481 |           · exact h\n482 |         U_plus_zero ⟨(n, μ), Finset.mem_union_right (positiveSites T L) hint⟩\n483 | \n484 | /-- Extend a configuration to a full link variable. -/\n485 | noncomputable def extendToFullConfig\n486 |     (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L))\n487 |     (U_plus_zero : PosInterfaceConfig N T L) :\n488 |     LinkVariable (SU N) (PeriodicSite T L) :=\n489 |   extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n490 |     (mergeConfigurations N T L U_minus U_plus_zero)\n491 | \n492 | /-- The transfer matrix T acting on functions of the positive+interface configuration. -/\n493 | noncomputable def transferMatrix (ψ : PosInterfaceConfig N T L → ℝ) :\n494 |     PosInterfaceConfig N T L → ℝ :=\n495 |   λ (U_plus_zero : PosInterfaceConfig N T L) =>\n496 |     ∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n497 |       ψ (restrictPosInterface N T L (mergeConfigurations N T L U_minus U_plus_zero)) *\n498 |       Real.exp (-β * wilsonActionOSInterface N T L β\n499 |         (extendToFullConfig N T L U_minus U_plus_zero))\n500 |     ∂ haarMeasureNegative N T L\n501 | \n502 | /-\n503 | ### Key Identity\n504 | -/\n505 | \n506 | /-- The function G = f · exp(-β·S_OS⁺) · exp(-β·S_OS_int/2). -/\n507 | noncomputable def G (N T L : ℕ) [NeZero T] [NeZero L] (hT : Odd T) (β : ℝ)\n508 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) (U : LinkVariable (SU N) (PeriodicSite T L)) : ℝ :=\n509 |   f U * Real.exp (-β * wilsonActionOSPositive N T L β U) *\n510 |   Real.exp (-β * wilsonActionOSInterface N T L β U / 2)\n511 | \n512 | /-- The restriction of G to the positive+interface configuration space. -/\n513 | noncomputable def G_plus (N T L : ℕ) [NeZero T] [NeZero L] (hT : Odd T) (β : ℝ)\n514 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) (cfg : PosInterfaceConfig N T L) : ℝ :=\n515 |   G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (positiveSites T L ∪ interfaceSites T L) cfg)\n516 | \n517 | lemma transferMatrix_identity (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) :\n518 |     (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n519 |       G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n520 |       G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n521 |       ∂ productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =\n522 |     (∫ (cfg : PosInterfaceConfig N T L),\n523 |       G_plus N T L hT β f cfg * (transferMatrix N T L β (G_plus N T L hT β f) cfg)\n524 |       ∂ haarMeasurePosInterface N T L) := by\n525 |   sorry\n526 | \n527 | /-- The interface Boltzmann kernel. -/\n528 | noncomputable def interfaceKernel\n529 |     (U_plus_zero : PosInterfaceConfig N T L)\n530 |     (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) : ℝ :=\n531 |   Real.exp (-β * wilsonActionOSInterface N T L β\n532 |     (extendToFullConfig N T L U_minus U_plus_zero))\n533 | \n534 | /-- `restrictPosInterface` after `mergeConfigurations` recovers the original positive+interface config. -/\n535 | lemma restrict_merge_id (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L))\n536 |     (U_plus_zero : PosInterfaceConfig N T L) :\n537 |     restrictPosInterface N T L (mergeConfigurations N T L U_minus U_plus_zero) = U_plus_zero := by\n538 |   ext x\n539 |   dsimp [restrictPosInterface, mergeConfigurations]\n540 |   by_cases hpos : x.1.1 ∈ positiveSites T L\n541 |   · simp [hpos]\n542 |   · -- x.1.1 ∉ positiveSites, so by x.2 it must be in interfaceSites\n543 |     have hint : x.1.1 ∈ interfaceSites T L := by\n544 |       rcases Finset.mem_union.mp x.2 with (hpos' | hint')\n545 |       · exact (hpos hpos').elim\n546 |       · exact hint'\n547 |     -- interfaceSites and negativeSites are disjoint because signed times differ (=0 vs <0)\n548 |     have h_not_neg : x.1.1 ∉ negativeSites T L := by\n549 |       intro hneg\n550 |       have hzero_time : signedTime T x.1.1.time = 0 := by\n551 |         dsimp [interfaceSites] at hint; simpa using hint\n552 |       have hneg_time : signedTime T x.1.1.time < 0 := by\n553 |         dsimp [negativeSites] at hneg; simpa using hneg\n554 |       linarith\n555 |     simp [hpos, hint, h_not_neg]\n556 | \n557 | \n558 | /-- The transfer matrix T is positive: ⟨ψ, Tψ⟩ ≥ 0 for all ψ. -/\n559 | lemma transferMatrix_positive (ψ : PosInterfaceConfig N T L → ℝ) :\n560 |     0 ≤ (∫ (cfg : PosInterfaceConfig N T L),\n561 |       ψ cfg * (transferMatrix N T L β ψ) cfg\n562 |       ∂ haarMeasurePosInterface N T L) := by\n563 |   -- The transfer matrix acts as multiplication by a positive kernel because\n564 |   -- `restrictPosInterface ∘ mergeConfigurations` is the identity on PosInterfaceConfig.\n565 |   -- Concretely:\n566 |   --   (Tψ)(cfg) = ψ(cfg) · ∫ exp(-β·S_OS_int(extendToFullConfig(U_minus, cfg))) dμ⁻(U_minus)\n567 |   have h_factor : ∀ (cfg : PosInterfaceConfig N T L),\n568 |       (transferMatrix N T L β ψ) cfg = ψ cfg *\n569 |         (∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n570 |           Real.exp (-β * wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus cfg))\n571 |           ∂ haarMeasureNegative N T L) := by\n572 |     intro cfg\n573 |     dsimp [transferMatrix]\n574 |     have h_simp : (λ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) =>\n575 |       ψ (restrictPosInterface N T L (mergeConfigurations N T L U_minus cfg)) *\n576 |       Real.exp (-β * wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus cfg))) =\n577 |       (λ (U_minus : _) => ψ cfg *\n578 |         Real.exp (-β * wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus cfg))) := by\n579 |       ext U_minus\n580 |       simp [restrict_merge_id N T L U_minus cfg]\n581 |     rw [h_simp, integral_const_mul]\n582 |   have h_nonneg_kernel : ∀ (cfg : PosInterfaceConfig N T L),\n583 |       0 ≤ ∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n584 |         Real.exp (-β * wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus cfg))\n585 |         ∂ haarMeasureNegative N T L := by\n586 |     intro cfg\n587 |     refine integral_nonneg (λ U_minus => ?_)\n588 |     exact le_of_lt (Real.exp_pos (-β * wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus cfg)))\n589 |   -- Now integrand = ψ(cfg) * (Tψ)(cfg) = ψ(cfg)² * kernel(cfg), which is pointwise ≥ 0\n590 |   refine integral_nonneg (λ cfg => ?_)\n591 |   rw [h_factor cfg, ← mul_assoc]\n592 |   exact mul_nonneg (mul_self_nonneg (ψ cfg)) (h_nonneg_kernel cfg)\n593 | \n594 | /-- ∫ G(U)·G(θU) dμ₀(U) ≥ 0. -/\n595 | lemma integral_G_thetaG_nonneg (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) :\n596 |     0 ≤ (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n597 |       G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n598 |       G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n599 |       ∂ productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) := by\n600 |   rw [transferMatrix_identity N T L hT β f]\n601 |   apply transferMatrix_positive N T L β (G_plus N T L hT β f)\n602 | \n603 | end TransferMatrix\n604 | \n605 | end Lattice\n606 | end YangMills\n","timestamp":1784083652,"token_count":11598,"tool_call_id":"call_00_N0k5vyuIUzf8aAu7BbeD2827","full_token_estimate":8402,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/TransferMatrix.lean","old_text":null,"new_text":nul