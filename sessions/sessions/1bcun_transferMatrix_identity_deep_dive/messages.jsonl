 (λ p => rfl)\n1309 |     _ = ∑ p : PlaquetteIndex T L, g p := by\n1310 |       refine Finset.sum_congr rfl (λ p hp => ?_)\n1311 |       rw [h_eq p]\n1312 | lemma gibbsExpectationPeriodic_reflection_positive (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L]\n1313 |     (hT : Odd T) (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) :\n1314 |     0 ≤ gibbsExpectation N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1315 |       (λ U => f U * reflectObservable N f U) := by\n1316 |   dsimp [gibbsExpectation]\n1317 |   have hZ_pos : partitionFunctionFinite N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) > 0 :=\n1318 |     partitionFunctionFinite_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1319 |   refine div_nonneg ?_ (le_of_lt hZ_pos)\n1320 |   set μ₀ := productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hμ₀\n1321 |   set S_total := wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hS\n1322 |   set U_ext := extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hU\n1323 |   have h_total_decomp : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1324 |       S_total cfg = wilsonActionOSPositive N T L β (U_ext cfg) +\n1325 |         wilsonActionOSNegative N T L β (U_ext cfg) +\n1326 |         wilsonActionOSInterface N T L β (U_ext cfg) := by\n1327 |     intro cfg\n1328 |     calc\n1329 |       S_total cfg = wilsonActionFinite N β (Finset.univ : Finset (PeriodicSite T L)) (U_ext cfg) := rfl\n1330 |       _ = wilsonActionOSPositive N T L β (U_ext cfg) +\n1331 |           wilsonActionOSNegative N T L β (U_ext cfg) +\n1332 |           wilsonActionOSInterface N T L β (U_ext cfg) :=\n1333 |         total_decomposition_os_periodic N T L β (U_ext cfg)\n1334 |   have h_neg_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1335 |       wilsonActionOSNegative N T L β (U_ext cfg) =\n1336 |       wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg)) := by\n1337 |     intro cfg\n1338 |     exact neg_action_reflection_os_periodic N T L β hT (U_ext cfg)\n1339 |   have h_int_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1340 |       wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) =\n1341 |       wilsonActionOSInterface N T L β (U_ext cfg) := by\n1342 |     intro cfg\n1343 |     exact interface_action_reflection_symmetric_os_periodic N T L β hT (U_ext cfg)\n1344 |   have h_factorization : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1345 |       Real.exp (-β * S_total cfg) = \n1346 |       (Real.exp (-β * wilsonActionOSPositive N T L β (U_ext cfg)) *\n1347 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) *\n1348 |       (Real.exp (-β * wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg))) *\n1349 |         Real.exp (-β * wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) / 2)) := by\n1350 |     intro cfg\n1351 |     rw [h_total_decomp cfg]\n1352 |     have h_mul : -β * (wilsonActionOSPositive N T L β (U_ext cfg) + wilsonActionOSNegative N T L β (U_ext cfg) +\n1353 |       wilsonActionOSInterface N T L β (U_ext cfg)) = \n1354 |       (-β * wilsonActionOSPositive N T L β (U_ext cfg)) + \n1355 |       (-β * wilsonActionOSNegative N T L β (U_ext cfg)) + \n1356 |       (-β * wilsonActionOSInterface N T L β (U_ext cfg)) := by ring\n1357 |     rw [h_mul]\n1358 |     rw [Real.exp_add, Real.exp_add]\n1359 |     rw [h_neg_reflect cfg, h_int_reflect cfg]\n1360 |     have h_exp_split : Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n1361 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n1362 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by\n1363 |       calc\n1364 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n1365 |           Real.exp ((-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) +\n1366 |                    (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) := by ring\n1367 |         _ = Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n1368 |             Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by rw [Real.exp_add]\n1369 |     rw [h_exp_split]\n1370 |     ring\n1371 |   set G := λ (U : LinkVariable (SU N) (PeriodicSite T L)) =>\n1372 |     f U * Real.exp (-β * wilsonActionOSPositive N T L β U) *\n1373 |     Real.exp (-β * wilsonActionOSInterface N T L β U / 2) with hG\n1374 |   have h_integrand_eq : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1375 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) *\n1376 |       Real.exp (-β * S_total cfg) =\n1377 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) := by\n1378 |     intro cfg\n1379 |     dsimp [G]\n1380 |     rw [h_factorization cfg]\n1381 |     ring\n1382 |   have h_fun_eq : (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1383 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg)) =\n1384 |     (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1385 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg))) := by\n1386 |     ext cfg; exact h_integrand_eq cfg\n1387 |   calc\n1388 |     (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1389 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg) ∂ μ₀)\n1390 |         = (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n1391 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) ∂ μ₀) := by\n1392 |       rw [h_fun_eq]\n1393 |     _ ≥ 0 := by\n1394 |       -- GOAL: Prove that ∫ G(U)·G(θU) dμ₀(U) ≥ 0.\n1395 |       --\n1396 |       -- This is the core of the Osterwalder–Seiler reflection positivity proof.\n1397 |       -- The integrand G·θG is NOT pointwise non-negative; the non-negativity\n1398 |       -- holds only after integration with respect to the product Haar measure.\n1399 |       --\n1400 |       -- MATHEMATICAL ARGUMENT (Osterwalder–Seiler 1979, §3):\n1401 |       --\n1402 |       -- The product Haar measure μ₀ on the finite periodic lattice factorises\n1403 |       -- as μ₀ = μ⁺ ⊗ μ⁻ ⊗ μ⁰, where μ⁺/μ⁻/μ⁰ are the Haar measures on links\n1404 |       -- in the positive-time, negative-time, and interface regions respectively.\n1405 |       --\n1406 |       -- Define the transfer matrix T acting on L²(μ⁺ ⊗ μ⁰) by:\n1407 |       --\n1408 |       --   (Tψ)(U⁺, U⁰) = ∫ ψ(U⁻, U⁰) · exp(-β · S_OS_int(U⁺, U⁻, U⁰)) dμ⁻(U⁻)\n1409 |       --\n1410 |       -- where S_OS_int is the interface part of the Wilson action.  The key\n1411 |       -- identity (proved algebraically above) is:\n1412 |       --\n1413 |       --   ∫ G(U)·G(θU) dμ₀(U) = ⟨G⁺, T·G⁺⟩_{L²(μ⁺ ⊗ μ⁰)}\n1414 |       --\n1415 |       -- where G⁺ is the restriction of G to variables in the positive-time and\n1416 |       -- interface regions.  The operator T is POSITIVE because the integral kernel\n1417 |       -- K(U⁺, U⁻, U⁰) = exp(-β · S_OS_int(U⁺, U⁻, U⁰)) is a positive-definite\n1418 |       -- function on (SU(N)ⁿ × SU(N)ⁿ).  This follows from the Peter–Weyl theorem\n1419 |       -- on SU(N): the matrix elements of the unitary irreducible representations\n1420 |       -- form an orthonormal basis of L²(SU(N)), and the Boltzmann factor expands\n1421 |       -- as a sum of squares in this basis (OS 1979, Theorem 3.1).\n1422 |       --\n1423 |       -- Consequently, ⟨G⁺, T·G⁺⟩ ≥ 0, and the integral is non-negative.\n1424 |       --\n1425 |       -- FORMALIZATION STATUS:\n1426 |       --\n1427 |       -- The Peter–Weyl theorem for SU(N) (or more generally for compact Lie groups)\n1428 |       -- is not yet available in Mathlib.  The spectral theory of compact integral\n1429 |       -- operators on L² is also not yet formalised.  Filling this gap requires:\n1430 |       --\n1431 |       --   1. The Peter–Weyl theorem: L²(SU(N)) ≅ ⊕_{λ} V_λ ⊗ V_λ^* (as\n1432 |       --      SU(N)×SU(N)-representations), where λ runs over dominant weights.\n1433 |       --   2. The Bochner–Minlos theorem or its Lie-group analogue: positive-definite\n1434 |       --      functions correspond to measures / states on the group C*-algebra.\n1435 |       --   3. Positivity of the transfer matrix T constructed from the Wilson\n1436 |       --      interface action.\n1437 |       --\n1438 |       -- REFERENCES:\n1439 |       --   - K. Osterwalder, E. Seiler, \"Gauge Field Theories on a Lattice\"\n1440 |       --     (Ann. Phys. 110, 1978, pp 440–471), §3.\n1441 |       --   - J. Glimm, A. Jaffe, \"Quantum Physics\" (2nd ed.), §6.1.\n1442 |       --   - M. Salmhofer, \"Construction of a Higgs field\" (thesis, 1990).\n1443 |       --\n1444 |       -- Until these results are available in Mathlib, the last step remains\n1445 |       -- an open `sorry`.  The rest of the reflection positivity proof (all\n1446 |       -- algebraic identities, the action decomposition, and the reduction\n1447 |       -- to the integral of G·θG) is fully formalised.\n1448 |       --\n1449 |       -- UPDATE: The lemma `integral_G_thetaG_nonneg` in `TransferMatrix.lean`\n1450 |       -- proves exactly this statement using the transfer matrix framework.\n1451 |       -- It depends on `transferMatrix_identity` (which remains a `sorry` in\n1452 |       -- TransferMatrix.lean). The `transferMatrix_positive` lemma is now proved\n1453 |       -- (T is a multiplication operator by a positive kernel because\n1454 |       --  `restrictPosInterface ∘ mergeConfigurations = id`).\n1455 |       --\n1456 |       -- The `transferMatrix_identity` requires a non-trivial change of variables\n1457 |       -- using the measure factorization `measure_factorization'` and the\n1458 |       -- Osterwalder-Seiler decomposition of the action. This is the last\n1459 |       -- remaining step in the OS proof.\n1460 |       --\n1461 |       -- Once `transferMatrix_identity` is proved, replace this `sorry` with:\n1462 |       --   apply integral_G_thetaG_nonneg N T L hT β f\n1463 |       sorry\n1464 | end OSDecomposition\n1465 | /--\n1466 | The `PeriodicExpectation` structure for the SU(N) Wilson action on a finite periodic lattice.\n1467 | This provides a reflection positivity certificate that does NOT require the `hadd` hypothesis,\n1468 | because periodic boundary conditions make the lattice closed under forward time translation.\n1469 | -/\n1470 | structure PeriodicExpectation (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hT : Odd T) : Type 1 where\n1471 |   /-- The partition function Z = ∫ exp(-S_W) dU. -/\n1472 |   partitionFunction : ℝ\n1473 |   /-- Positivity of the partition function: Z > 0 for β > 0. -/\n1474 |   partitionFunctionPos : partitionFunction > 0\n1475 |   /-- The expectation of an observable F. -/\n1476 |   evaluate : (LinkVariable (SU N) (PeriodicSite T L) → ℝ) → ℝ\n1477 |   /-- Linearity of expectation. -/\n1478 |   linearity : ∀ (a b : ℝ) (F G : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1479 |     (MeasureTheory.Integrable (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1480 |       F (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n1481 |       Real.exp (-β * wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n1482 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)))) →\n1483 |     (MeasureTheory.Integrable (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n1484 |       G (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n1485 |       Real.exp (-β * wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n1486 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)))) →\n1487 |     evaluate (λ U => a * F U + b * G U) = a * evaluate F + b * evaluate G\n1488 |   /-- Normalization: ⟨1⟩ = 1. -/\n1489 |   normalization : evaluate (λ _ => 1) = 1\n1490 |   /-- Positivity: if F ≥ 0 pointwise, then ⟨F⟩ ≥ 0. -/\n1491 |   positivity : ∀ (F : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1492 |     (∀ U, F U ≥ 0) → evaluate F ≥ 0\n1493 |   /-- Reflection positivity: ⟨f · θ(f)⟩ ≥ 0. -/\n1494 |   reflectionPositive : ∀ (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1495 |     evaluate (λ U => f U * reflectObservable N f U) ≥ 0\n1496 | \n1497 | /--\n1498 | Construct a `PeriodicExpectation` for the Wilson action on a finite periodic lattice.\n1499 | This uses the Osterwalder-Seiler factorization to prove reflection positivity without\n1500 | the `hadd` limitation of the Z4Site version.\n1501 | -/\n1502 | noncomputable def wilsonPeriodicExpectation (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hT : Odd T) :\n1503 |     PeriodicExpectation N T L β hT :=\n1504 |   {\n1505 |     partitionFunction := partitionFunctionFinite N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1506 |     partitionFunctionPos := partitionFunctionFinite_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1507 |     evaluate := gibbsExpectation N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1508 |     linearity := λ a b F G hF hG =>\n1509 |       gibbsExpectation_linear N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) a b F G hF hG\n1510 |     normalization := gibbsExpectation_normalization N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n1511 |     positivity := λ F hF => gibbsExpectation_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) F hF\n1512 |     reflectionPositive := λ f =>\n1513 |       gibbsExpectationPeriodic_reflection_positive N T L β hT f\n1514 |   }\n1515 | /--\n1516 | The SU(N) lattice Yang-Mills measure with the Wilson action on a finite periodic lattice\n1517 | is reflection positive. This theorem does NOT require the `hadd` hypothesis, because the\n1518 | periodic boundary conditions make `addVector` closed on the full lattice automatically.\n1519 | -/\n1520 | theorem lattice_ym_reflection_positive_periodic (N T L : ℕ) (β : ℝ) [NeZero T] [NeZero L] (hβ : β > 0) (hT : Odd T) :\n1521 |     ∀ (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ),\n1522 |       (wilsonPeriodicExpectation N T L β hT).evaluate (λ U => f U * reflectObservable N f U) ≥ 0 := by\n1523 |   intro f\n1524 |   exact (wilsonPeriodicExpectation N T L β hT).reflectionPositive f\n1525 | \n1526 | end PeriodicSite\n","timestamp":1784083652,"token_count":5824,"tool_call_id":"call_01_2REWQ1mAHr0cmKHgd7vz0320","full_token_estimate":4225,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/ReflectionPositivity.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":1526,"byte_count":94678,"is_error":false,"duration_ms":0,"edit_line":null},"turn":3,"is_prune_marker":false}
{"id":13,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\LatticeMeasure.lean\n-- 521 lines, 30684 bytes --\n  1 | /-\n  2 | # Lattice Yang-Mills Measure\n  3 | -/\n  4 | import YangMills.Lattice\n  5 | import YangMills.SpecialUnitary\n  6 | import Mathlib.MeasureTheory.Measure.Haar.Basic\n  7 | import Mathlib.MeasureTheory.Integral.Pi\n  8 | import Mathlib.MeasureTheory.Constructions.Pi\n  9 | \n 10 | open Set Matrix MeasureTheory\n 11 | open scoped MeasureTheory\n 12 | open Complex\n 13 | \n 14 | namespace YangMills\n 15 | namespace Lattice\n 16 | \n 17 | /-- MeasurableSpace on `LinkVariable` induced by the `value` projection. -/\n 18 | instance {G : Type} {Λ : Type} [MeasurableSpace G] :\n 19 |     MeasurableSpace (LinkVariable G Λ) :=\n 20 |   MeasurableSpace.comap (fun U => U.value) inferInstance\n 21 | \n 22 | section LinkSet\n 23 | def LinkSet (Λ : Type) : Type := Λ × Fin 4\n 24 | abbrev LinkConfig (N : ℕ) (Λ : Type) : Type := LinkSet Λ → SU N\n 25 | def linkVariableToConfig (N : ℕ) (Λ : Type) (U : LinkVariable (SU N) Λ) : LinkConfig N Λ :=\n 26 |   λ (site, μ) => U.value site μ\n 27 | def configToLinkVariable (N : ℕ) (Λ : Type) (U : LinkConfig N Λ) : LinkVariable (SU N) Λ :=\n 28 |   { value := λ site μ => U (site, μ) }\n 29 | lemma linkVariableConfig_bijection (N : ℕ) (Λ : Type) (U : LinkVariable (SU N) Λ) :\n 30 |     configToLinkVariable N Λ (linkVariableToConfig N Λ U) = U := by\n 31 |   ext site μ; simp [linkVariableToConfig, configToLinkVariable]\n 32 | lemma configLinkVariable_bijection (N : ℕ) (Λ : Type) (U : LinkConfig N Λ) :\n 33 |     linkVariableToConfig N Λ (configToLinkVariable N Λ U) = U := by\n 34 |   ext ⟨site, μ⟩; simp [linkVariableToConfig, configToLinkVariable]\n 35 | end LinkSet\n 36 | \n 37 | section ProductHaarMeasure\n 38 | \n 39 | section GenericProductMeasure\n 40 | \n 41 | /-- The index set of links in a finite lattice: pairs (site, direction) where site ∈ sites. -/\n 42 | def FiniteLinkIndex (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) : Type :=\n 43 |   Subtype (λ (x : Λ × Fin 4) => x.1 ∈ sites)\n 44 | \n 45 | instance (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) : Fintype (FiniteLinkIndex Λ sites) :=\n 46 |   Fintype.subtype (sites.product (Finset.univ : Finset (Fin 4))) (by intro x; simp)\n 47 | \n 48 | /-- A link configuration on a finite lattice is an assignment of SU(N) group elements\n 49 | to each directed link (site, μ) where site ∈ sites. -/\n 50 | abbrev FiniteLinkConfig (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) : Type :=\n 51 |   FiniteLinkIndex Λ sites → SU N\n 52 | \n 53 | /-- Product Haar measure on SU(N)^{sites × {0,1,2,3}}. -/\n 54 | noncomputable def productHaarMeasure (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) :\n 55 |     Measure (FiniteLinkConfig N Λ sites) :=\n 56 |   let K : TopologicalSpace.PositiveCompacts (SU N) :=\n 57 |     ⟨⟨Set.univ, isCompact_univ⟩, by simpa using Set.univ_nonempty (α := SU N)⟩\n 58 |   MeasureTheory.Measure.pi (λ _ : FiniteLinkIndex Λ sites => MeasureTheory.Measure.haarMeasure K)\n 59 | \n 60 | /-- Extend a configuration on `sites` to a full link variable by setting missing links to 1. -/\n 61 | noncomputable def extendLinkVariable (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ)\n 62 |     (U : FiniteLinkConfig N Λ sites) : LinkVariable (SU N) Λ :=\n 63 |   { value := λ n μ => if h : n ∈ sites then U ⟨(n, μ), h⟩ else 1 }\n 64 | \n 65 | /-- Restrict a full link variable to a configuration on `sites`. -/\n 66 | noncomputable def restrictLinkVariable (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ)\n 67 |     (U : LinkVariable (SU N) Λ) : FiniteLinkConfig N Λ sites :=\n 68 |   λ ⟨(n, μ), hn⟩ => U.value n μ\n 69 | \n 70 | /-- The Wilson action evaluated on a finite-link configuration. -/\n 71 | noncomputable def wilsonActionFiniteConfig (N : ℕ) (β : ℝ) (Λ : Type) [DecidableEq Λ] [AddVector Λ]\n 72 |     (sites : Finset Λ) (cfg : FiniteLinkConfig N Λ sites) : ℝ :=\n 73 |   wilsonActionFinite N β sites (extendLinkVariable N Λ sites cfg)\n 74 | \n 75 | /-- `extendLinkVariable` is measurable: each component is either an evaluation (measurable)\n 76 | or a constant (measurable), depending on whether the site is in the lattice. -/\n 77 | lemma measurable_extendLinkVariable (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) :\n 78 |     Measurable (extendLinkVariable N Λ sites) := by\n 79 |   have h : Measurable ((fun U : LinkVariable (SU N) Λ => U.value) ∘ extendLinkVariable N Λ sites) := by\n 80 |     show Measurable (fun (U : FiniteLinkConfig N Λ sites) (n : Λ) (μ : Fin 4) =>\n 81 |       if h : n ∈ sites then U ⟨(n, μ), h⟩ else (1 : SU N))\n 82 |     rw [measurable_pi_iff]\n 83 |     intro n\n 84 |     rw [measurable_pi_iff]\n 85 |     intro μ\n 86 |     by_cases h : n ∈ sites\n 87 |     · simp only [h, if_pos]\n 88 |       exact measurable_pi_apply (⟨(n, μ), h⟩ : FiniteLinkIndex Λ sites)\n 89 |     · simp only [h, if_neg]\n 90 |       exact measurable_const\n 91 |   exact measurable_comap_iff.mpr h\n 92 | \n 93 | /-- `LinkVariable.value` is surjective: every function comes from a LinkVariable. -/\n 94 | lemma LinkVariable.value_surjective (G : Type) (Λ : Type) :\n 95 |     Function.Surjective (fun (U : LinkVariable G Λ) => U.value) := by\n 96 |   intro f; exact ⟨{ value := f }, rfl⟩\n 97 | \n 98 | /-- `wilsonActionFiniteConfig` is measurable, expressed as a finite sum of measurable terms.\n 99 | Each term `plaquetteContribution N β (extendLinkVariable N Λ sites cfg) n μ ν` is measurable\n100 | because it depends on `cfg` at finitely many indices via continuous SU(N) operations\n101 | (multiplication, inversion, trace, real part). -/\n102 | lemma measurable_wilsonActionFiniteConfig (N : ℕ) (β : ℝ) (Λ : Type) [DecidableEq Λ] [AddVector Λ]\n103 |     (sites : Finset Λ) : Measurable (wilsonActionFiniteConfig N β Λ sites) := by\n104 |   unfold wilsonActionFiniteConfig wilsonActionFinite\n105 |   refine Finset.measurable_sum _ (λ n hn => ?_)\n106 |   refine Finset.measurable_sum _ (λ μ hμ => ?_)\n107 |   refine Finset.measurable_sum _ (λ ν hν => ?_)\n108 |   unfold plaquetteContribution\n109 |   -- Each term: β * (1 - (1 / (N : ℝ)) * ((trace (plaquetteProduct ...)).re : ℝ))\n110 |   -- Show the innermost part (trace ...).re is measurable\n111 |   have h_meas_inner : Measurable (λ (cfg : FiniteLinkConfig N Λ sites) =>\n112 |     ((trace ((plaquetteProduct N (extendLinkVariable N Λ sites cfg) n μ ν : Matrix (Fin N) (Fin N) ℂ))).re : ℝ)) := by\n113 |     have h_cont_trace_re : Continuous (λ (g : SU N) => ((trace ((g : Matrix (Fin N) (Fin N) ℂ))).re : ℝ)) := by\n114 |       -- trace = λ A => ∑ᵢ Aᵢᵢ is continuous as a sum of projections\n115 |       have h_cont_trace : Continuous (trace : Matrix (Fin N) (Fin N) ℂ → ℂ) := by\n116 |         have h_eq : trace = λ (A : Matrix (Fin N) (Fin N) ℂ) => ∑ i : Fin N, A i i := by\n117 |           ext A; simp [Matrix.trace]\n118 |         rw [h_eq]\n119 |         refine continuous_finsetSum Finset.univ (λ i hi => ?_)\n120 |         -- A i i is the (i,i) entry, which is continuous\n121 |         have h_entry : Continuous (λ (A : Matrix (Fin N) (Fin N) ℂ) => A i i) :=\n122 |           (continuous_apply i).comp (continuous_apply i)\n123 |         exact h_entry\n124 |       -- The inclusion SU N → Matrix is continuous (subtype)\n125 |       have h_cont_val : Continuous (Subtype.val : SU N → Matrix (Fin N) (Fin N) ℂ) :=\n126 |         continuous_subtype_val\n127 |       -- re is continuous\n128 |       have h_cont_re : Continuous (Complex.re : ℂ → ℝ) := Complex.continuous_re\n129 |       -- Composition: g ↦ (g : Matrix) ↦ trace(...) ↦ re(trace)\n130 |       exact h_cont_re.comp (h_cont_trace.comp h_cont_val)\n131 |     have h_cont_pp : Continuous (λ (cfg : FiniteLinkConfig N Λ sites) =>\n132 |       plaquetteProduct N (extendLinkVariable N Λ sites cfg) n μ ν) := by\n133 |       have h_val_cont (n' : Λ) (μ' : Fin 4) : Continuous (λ (cfg : FiniteLinkConfig N Λ sites) =>\n134 |         (extendLinkVariable N Λ sites cfg).value n' μ') := by\n135 |         by_cases h : n' ∈ sites\n136 |         · have h_eq : (λ (cfg : FiniteLinkConfig N Λ sites) => (extendLinkVariable N Λ sites cfg).value n' μ') =\n137 |             (λ cfg : FiniteLinkConfig N Λ sites => cfg ⟨(n', μ'), h⟩) := by\n138 |             ext cfg; simp [extendLinkVariable, h]\n139 |           rw [h_eq]\n140 |           exact continuous_apply (⟨(n', μ'), h⟩ : FiniteLinkIndex Λ sites)\n141 |         · have h_eq : (λ (cfg : FiniteLinkConfig N Λ sites) => (extendLinkVariable N Λ sites cfg).value n' μ') =\n142 |             (λ _ : FiniteLinkConfig N Λ sites => (1 : SU N)) := by\n143 |             ext cfg; simp [extendLinkVariable, h]\n144 |           rw [h_eq]\n145 |           exact continuous_const\n146 |       unfold plaquetteProduct\n147 |       have h_ab : Continuous (λ (cfg : FiniteLinkConfig N Λ sites) =>\n148 |         (extendLinkVariable N Λ sites cfg).value n μ * (extendLinkVariable N Λ sites cfg).value (AddVector.addVector n μ) ν) :=\n149 |         Continuous.mul (h_val_cont n μ) (h_val_cont (AddVector.addVector n μ) ν)\n150 |       have h_abc : Continuous (λ (cfg : FiniteLinkConfig N Λ sites) =>\n151 |         (extendLinkVariable N Λ sites cfg).value n μ * (extendLinkVariable N Λ sites cfg).value (AddVector.addVector n μ) ν *\n152 |         ((extendLinkVariable N Λ sites cfg).value (AddVector.addVector (AddVector.addVector n μ) ν) μ)⁻¹) :=\n153 |         Continuous.mul h_ab (Continuous.inv (h_val_cont (AddVector.addVector (AddVector.addVector n μ) ν) μ))\n154 |       exact Continuous.mul h_abc (Continuous.inv (h_val_cont (AddVector.addVector n ν) ν))\n155 |     have h_cont_total : Continuous (λ (cfg : FiniteLinkConfig N Λ sites) =>\n156 |       ((trace ((plaquetteProduct N (extendLinkVariable N Λ sites cfg) n μ ν : Matrix (Fin N) (Fin N) ℂ))).re : ℝ)) :=\n157 |       h_cont_trace_re.comp h_cont_pp\n158 |     haveI : OpensMeasurableSpace (FiniteLinkConfig N Λ sites) := by\n159 |       infer_instance\n160 |     exact h_cont_total.measurable\n161 |   have h_term : Measurable (λ (cfg : FiniteLinkConfig N Λ sites) =>\n162 |     β * ((1 : ℝ) - (1 / (N : ℝ)) * ((trace ((plaquetteProduct N (extendLinkVariable N Λ sites cfg) n μ ν :\n163 |       Matrix (Fin N) (Fin N) ℂ))).re : ℝ))) := by\n164 |     refine Measurable.const_mul (Measurable.sub (by exact measurable_const)\n165 |       (Measurable.const_mul h_meas_inner (1 / (N : ℝ)))) β\n166 |   exact h_term\n167 | \n168 | lemma productHaarMeasure_total_volume (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) :\n169 |     productHaarMeasure N Λ sites (Set.univ : Set (FiniteLinkConfig N Λ sites)) = 1 := by\n170 |   dsimp [productHaarMeasure]\n171 |   rw [MeasureTheory.Measure.pi_univ]\n172 |   let K : TopologicalSpace.PositiveCompacts (SU N) :=\n173 |     ⟨⟨Set.univ, isCompact_univ⟩, by simpa using Set.univ_nonempty (α := SU N)⟩\n174 |   have h_one : Measure.haarMeasure K (Set.univ : Set (SU N)) = 1 := by\n175 |     simpa [K] using Measure.haarMeasure_self (K₀ := K)\n176 |   have h_prod : (∏ _ : FiniteLinkIndex Λ sites, Measure.haarMeasure K (Set.univ : Set (SU N))) = 1 := by\n177 |     simp [h_one]\n178 |   simpa [K] using h_prod\n179 | \n180 | lemma productHaarMeasure_isFiniteMeasure (N : ℕ) (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) :\n181 |     IsFiniteMeasure (productHaarMeasure N Λ sites) := by\n182 |   have h_total : productHaarMeasure N Λ sites (Set.univ : Set (FiniteLinkConfig N Λ sites)) = 1 :=\n183 |     productHaarMeasure_total_volume N Λ sites\n184 |   refine { measure_univ_lt_top := ?_ }\n185 |   rw [h_total]\n186 |   exact ENNReal.one_lt_top\n187 | \n188 | /-- The partition function for a finite lattice with Wilson action. -/\n189 | noncomputable def partitionFunctionFinite (N : ℕ) (β : ℝ) (Λ : Type) [DecidableEq Λ] [AddVector Λ]\n190 |     (sites : Finset Λ) : ℝ :=\n191 |   ∫ (U : FiniteLinkConfig N Λ sites), Real.exp (-β * wilsonActionFiniteConfig N β Λ sites U)\n192 |     ∂ productH