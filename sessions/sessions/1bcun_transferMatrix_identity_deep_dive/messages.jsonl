{"id":11,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 606 lines, 34063 bytes --\n  1 | /-\n  2 | # Transfer Matrix Positivity: Proof Sketch\n  3 | \n  4 | This file provides a structured proof sketch for the remaining `sorry` in\n  5 | `gibbsExpectationPeriodic_reflection_positive`. It defines the transfer matrix\n  6 | framework.\n  7 | -/\n  8 | import YangMills.Proofs.ReflectionPositivity\n  9 | import Mathlib.MeasureTheory.Measure.MeasureSpaceDef\n 10 | import Mathlib.MeasureTheory.Constructions.Pi\n 11 | import Mathlib.Analysis.SpecialFunctions.Exp\n 12 | import Mathlib.MeasureTheory.Measure.Haar.Basic\n 13 | \n 14 | open Set\n 15 | open Matrix\n 16 | open scoped BigOperators\n 17 | open MeasureTheory\n 18 | \n 19 | namespace YangMills\n 20 | namespace Lattice\n 21 | \n 22 | section TransferMatrix\n 23 | \n 24 | variable (N T L : ℕ) [NeZero T] [NeZero L] (hT : Odd T) (β : ℝ)\n 25 | \n 26 | /-- The set of links at positive-time sites. -/\n 27 | noncomputable def positiveLinks : Finset (PeriodicSite T L × Fin 4) :=\n 28 |   (positiveSites T L).product (Finset.univ : Finset (Fin 4))\n 29 | \n 30 | /-- The set of links at negative-time sites. -/\n 31 | noncomputable def negativeLinks : Finset (PeriodicSite T L × Fin 4) :=\n 32 |   (negativeSites T L).product (Finset.univ : Finset (Fin 4))\n 33 | \n 34 | /-- The set of links at interface sites. -/\n 35 | noncomputable def interfaceLinks : Finset (PeriodicSite T L × Fin 4) :=\n 36 |   (interfaceSites T L).product (Finset.univ : Finset (Fin 4))\n 37 | \n 38 | lemma linkPartition_disjoint_union :\n 39 |     positiveLinks T L ∪ negativeLinks T L ∪ interfaceLinks T L =\n 40 |     (Finset.univ : Finset (PeriodicSite T L × Fin 4)) := by\n 41 |   ext ⟨n, μ⟩; simp [positiveLinks, negativeLinks, interfaceLinks, positiveSites,\n 42 |     negativeSites, interfaceSites]\n 43 |   by_cases hpos : signedTime T n.time > 0\n 44 |   · simp [hpos]\n 45 |   · by_cases hneg : signedTime T n.time < 0\n 46 |     · simp [hpos, hneg]\n 47 |     · have hzero : signedTime T n.time = 0 := by\n 48 |         have hle : signedTime T n.time ≤ 0 := by linarith\n 49 |         have hge : signedTime T n.time ≥ 0 := by linarith\n 50 |         linarith\n 51 |       simp [hpos, hneg, hzero]\n 52 | \n 53 | lemma linkPartition_disjoint :\n 54 |     Disjoint (positiveLinks T L) (negativeLinks T L) ∧\n 55 |     Disjoint (positiveLinks T L) (interfaceLinks T L) ∧\n 56 |     Disjoint (negativeLinks T L) (interfaceLinks T L) := by\n 57 |   have h_pos_neg_sites : Disjoint (positiveSites T L) (negativeSites T L) := by\n 58 |     unfold positiveSites negativeSites\n 59 |     rw [Finset.disjoint_filter]\n 60 |     intro n hn hpos hneg\n 61 |     linarith\n 62 |   have h_pos_int_sites : Disjoint (positiveSites T L) (interfaceSites T L) := by\n 63 |     unfold positiveSites interfaceSites\n 64 |     rw [Finset.disjoint_filter]\n 65 |     intro n hn hpos hzero\n 66 |     linarith\n 67 |   have h_neg_int_sites : Disjoint (negativeSites T L) (interfaceSites T L) := by\n 68 |     unfold negativeSites interfaceSites\n 69 |     rw [Finset.disjoint_filter]\n 70 |     intro n hn hneg hzero\n 71 |     linarith\n 72 |   have h_pos_neg_links : Disjoint (positiveLinks T L) (negativeLinks T L) := by\n 73 |     unfold positiveLinks negativeLinks\n 74 |     simpa using (Finset.disjoint_product (s := positiveSites T L) (t := Finset.univ)\n 75 |       (s' := negativeSites T L) (t' := Finset.univ)).mpr (Or.inl h_pos_neg_sites)\n 76 |   have h_pos_int_links : Disjoint (positiveLinks T L) (interfaceLinks T L) := by\n 77 |     unfold positiveLinks interfaceLinks\n 78 |     simpa using (Finset.disjoint_product (s := positiveSites T L) (t := Finset.univ)\n 79 |       (s' := interfaceSites T L) (t' := Finset.univ)).mpr (Or.inl h_pos_int_sites)\n 80 |   have h_neg_int_links : Disjoint (negativeLinks T L) (interfaceLinks T L) := by\n 81 |     unfold negativeLinks interfaceLinks\n 82 |     simpa using (Finset.disjoint_product (s := negativeSites T L) (t := Finset.univ)\n 83 |       (s' := interfaceSites T L) (t' := Finset.univ)).mpr (Or.inl h_neg_int_sites)\n 84 |   exact ⟨h_pos_neg_links, h_pos_int_links, h_neg_int_links⟩\n 85 | \n 86 | /-- Haar measure on the positive links. -/\n 87 | noncomputable def haarMeasurePositive : Measure (FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) :=\n 88 |   productHaarMeasure N (PeriodicSite T L) (positiveSites T L)\n 89 | \n 90 | /-- Haar measure on the negative links. -/\n 91 | noncomputable def haarMeasureNegative : Measure (FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) :=\n 92 |   productHaarMeasure N (PeriodicSite T L) (negativeSites T L)\n 93 | \n 94 | /-- Haar measure on the interface links. -/\n 95 | noncomputable def haarMeasureInterface : Measure (FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) :=\n 96 |   productHaarMeasure N (PeriodicSite T L) (interfaceSites T L)\n 97 | \n 98 | /-- A helper equivalence: `FiniteLinkIndex Λ (s₁ ∪ s₂) ≃ FiniteLinkIndex Λ s₁ ⊕ FiniteLinkIndex Λ s₂`\n 99 | for disjoint s₁, s₂. -/\n100 | noncomputable def finiteLinkIndexUnionSum {Λ : Type} [DecidableEq Λ] {s₁ s₂ : Finset Λ}\n101 |     (h : Disjoint s₁ s₂) : FiniteLinkIndex Λ (s₁ ∪ s₂) ≃ FiniteLinkIndex Λ s₁ ⊕ FiniteLinkIndex Λ s₂ where\n102 |   toFun := λ x =>\n103 |     if h₁ : x.1.1 ∈ s₁ then\n104 |       Sum.inl ⟨(x.1.1, x.1.2), h₁⟩\n105 |     else\n106 |       have h₂ : x.1.1 ∈ s₂ := by\n107 |         rcases Finset.mem_union.mp x.2 with (h₁' | h₂')\n108 |         · exact (h₁ h₁').elim\n109 |         · exact h₂'\n110 |       Sum.inr ⟨(x.1.1, x.1.2), h₂⟩\n111 |   invFun := λ y => match y with\n112 |     | Sum.inl ⟨(n, μ), hn⟩ => ⟨(n, μ), Finset.mem_union_left s₂ hn⟩\n113 |     | Sum.inr ⟨(n, μ), hn⟩ => ⟨(n, μ), Finset.mem_union_right s₁ hn⟩\n114 |   left_inv := by\n115 |     intro x\n116 |     apply Subtype.ext\n117 |     by_cases h₁ : x.1.1 ∈ s₁\n118 |     · simp [h₁]\n119 |     · have h₂ : x.1.1 ∈ s₂ := by\n120 |         rcases Finset.mem_union.mp x.2 with (h₁' | h₂')\n121 |         · exact (h₁ h₁').elim\n122 |         · exact h₂'\n123 |       simp [h₁, h₂]\n124 |   right_inv := by\n125 |     intro y\n126 |     rcases y with (⟨⟨n, μ⟩, hn⟩ | ⟨⟨n, μ⟩, hn⟩)\n127 |     · -- Sum.inl case: hn : (n, μ).1 ∈ s₁, i.e. n ∈ s₁\n128 |       simp [hn]\n129 |     · -- Sum.inr case: hn : (n, μ).1 ∈ s₂, i.e. n ∈ s₂, and s₁, s₂ are disjoint\n130 |       have hn' : n ∉ s₁ := by\n131 |         intro hn1\n132 |         have h_disj : s₁ ∩ s₂ = ∅ := Finset.disjoint_iff_inter_eq_empty.mp h\n133 |         have mem_inter : n ∈ s₁ ∩ s₂ := Finset.mem_inter.mpr ⟨hn1, hn⟩\n134 |         rw [h_disj] at mem_inter\n135 |         simpa using mem_inter\n136 |       simp [hn']\n137 | \n138 | /-- The product Haar measure on FiniteLinkConfig is Measure.pi on the FiniteLinkIndex type,\n139 | and we can move between FiniteLinkIndex and the product Finset via a bijection. -/\n140 | noncomputable def finiteLinkIndexEquiv (Λ : Type) [DecidableEq Λ] (sites : Finset Λ) :\n141 |     FiniteLinkIndex Λ sites ≃ (sites.product (Finset.univ : Finset (Fin 4))) where\n142 |   toFun := λ x =>\n143 |     let n := x.1.1; let μ := x.1.2; let hn : n ∈ sites := x.2\n144 |     ⟨(n, μ), by simp [hn, Finset.mem_product, Finset.mem_univ]⟩\n145 |   invFun := λ y =>\n146 |     let n := y.1.1; let μ := y.1.2\n147 |     have hn : n ∈ sites := by\n148 |       rcases Finset.mem_product.mp y.2 with ⟨hn, hμ⟩\n149 |       exact hn\n150 |     ⟨(n, μ), hn⟩\n151 |   left_inv := by\n152 |     intro x\n153 |     let n := x.1.1; let μ := x.1.2; let hn : n ∈ sites := x.2\n154 |     rfl\n155 |   right_inv := by\n156 |     intro y\n157 |     let n := y.1.1; let μ := y.1.2\n158 |     rcases Finset.mem_product.mp y.2 with ⟨hn, hμ⟩\n159 |     rfl\n160 | \n161 | lemma measure_factorization' :\n162 |     ∃ (e : (FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n163 |             FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L) ×\n164 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) ≃ᵐ\n165 |            FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n166 |     MeasurePreserving e\n167 |       ((haarMeasurePositive N T L).prod ((haarMeasureNegative N T L).prod (haarMeasureInterface N T L)))\n168 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) := by\n169 |   -- Rename to avoid shadowing N (the ℕ parameter)\n170 |   let posSites := positiveSites T L\n171 |   let negSites := negativeSites T L\n172 |   let intSites := interfaceSites T L\n173 |   let A := posSites ∪ negSites\n174 |   let All := A ∪ intSites\n175 |   have hPN : Disjoint posSites negSites := by\n176 |     unfold posSites negSites positiveSites negativeSites\n177 |     rw [Finset.disjoint_filter]\n178 |     intro n hn hpos hneg; linarith\n179 |   have hAI : Disjoint A intSites := by\n180 |     rw [Finset.disjoint_union_left]\n181 |     have hPI : Disjoint posSites intSites := by\n182 |       unfold posSites intSites positiveSites interfaceSites\n183 |       rw [Finset.disjoint_filter]\n184 |       intro n hn hpos hzero; linarith\n185 |     have hNI : Disjoint negSites intSites := by\n186 |       unfold negSites intSites negativeSites interfaceSites\n187 |       rw [Finset.disjoint_filter]\n188 |       intro n hn hneg hzero; linarith\n189 |     exact ⟨hPI, hNI⟩\n190 |   have hAll_eq : All = Finset.univ := by\n191 |     apply Finset.eq_univ_of_forall\n192 |     intro n\n193 |     dsimp [All, A, posSites, negSites, intSites]\n194 |     by_cases hpos : signedTime T n.time > 0\n195 |     · have hposSite : n ∈ positiveSites T L := by\n196 |         dsimp [positiveSites]; simp [hpos]\n197 |       apply Finset.mem_union_left\n198 |       apply Finset.mem_union_left\n199 |       exact hposSite\n200 |     · by_cases hneg : signedTime T n.time < 0\n201 |       · have hnegSite : n ∈ negativeSites T L := by\n202 |           dsimp [negativeSites]; simp [hneg]\n203 |         apply Finset.mem_union_left\n204 |         apply Finset.mem_union_right\n205 |         exact hnegSite\n206 |       · have hzero : signedTime T n.time = 0 := by\n207 |           have hle : signedTime T n.time ≤ 0 := by linarith\n208 |           have hge : signedTime T n.time ≥ 0 := by linarith\n209 |           linarith\n210 |         have hintSite : n ∈ interfaceSites T L := by\n211 |           dsimp [interfaceSites]; simp [hzero]\n212 |         apply Finset.mem_union_right\n213 |         exact hintSite\n214 |   -- We use the Haar measure on SU(N) as the basic building block for productHaarMeasure\n215 |   let K : TopologicalSpace.PositiveCompacts (SU N) :=\n216 |     ⟨⟨Set.univ, isCompact_univ⟩, by simpa using Set.univ_nonempty (α := SU N)⟩\n217 |   have hK_sigma : ∀ (_ : FiniteLinkIndex (PeriodicSite T L) Finset.univ),\n218 |       SigmaFinite (MeasureTheory.Measure.haarMeasure K) := by\n219 |     intro; infer_instance\n220 |   -- productHaarMeasure = Measure.pi (λ _ => haarMeasure K)\n221 |   have hprod_eq (sites : Finset (PeriodicSite T L)) :\n222 |       productHaarMeasure N (PeriodicSite T L) sites =\n223 |         Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) sites) => MeasureTheory.Measure.haarMeasure K := by\n224 |     rfl\n225 |   -- Step 1: C(posSites) × C(negSites) ≃ᵐ C(A) (for posSites, negSites disjoint)\n226 |   have hf1_mp : MeasurePreserving\n227 |     (((MeasurableEquiv.sumPiEquivProdPi\n228 |       (fun _ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites => SU N)).symm).trans\n229 |     (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) A => SU N)\n230 |       (finiteLinkIndexUnionSum hPN).symm))\n231 |     ((productHaarMeasure N (PeriodicSite T L) posSites).prod (productHaarMeasure N (PeriodicSite T L) negSites))\n232 |     (productHaarMeasure N (PeriodicSite T L) A) := by\n233 |     -- The composition of two measure-preserving maps\n234 |     have h_sum : MeasurePreserving\n235 |       (MeasurableEquiv.sumPiEquivProdPi\n236 |         (fun _ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites => SU N)).symm\n237 |       ((Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) posSites) => MeasureTheory.Measure.haarMeasure K).prod\n238 |         (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) negSites) => MeasureTheory.Measure.haarMeasure K))\n239 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites) =>\n240 |         MeasureTheory.Measure.haarMeasure K) := by\n241 |       exact measurePreserving_sumPiEquivProdPi_symm (fun _ => MeasureTheory.Measure.haarMeasure K)\n242 |     have h_congr : MeasurePreserving\n243 |       (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) A => SU N)\n244 |         (finiteLinkIndexUnionSum hPN).symm)\n245 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites) =>\n246 |         MeasureTheory.Measure.haarMeasure K)\n247 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A) => MeasureTheory.Measure.haarMeasure K) := by\n248 |       simpa [Function.comp] using\n249 |         measurePreserving_piCongrLeft (fun (_ : FiniteLinkIndex (PeriodicSite T L) A) =>\n250 |           MeasureTheory.Measure.haarMeasure K) (finiteLinkIndexUnionSum hPN).symm\n251 |     -- Compose: the trans of MeasurableEquiv corresponds to comp of MeasurePreserving\n252 |     have h_comp : MeasurePreserving\n253 |       (((MeasurableEquiv.sumPiEquivProdPi\n254 |         (fun _ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites => SU N)).symm).trans\n255 |       (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) A => SU N)\n256 |         (finiteLinkIndexUnionSum hPN).symm))\n257 |       ((Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) posSites) => MeasureTheory.Measure.haarMeasure K).prod\n258 |         (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) negSites) => MeasureTheory.Measure.haarMeasure K))\n259 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A) => MeasureTheory.Measure.haarMeasure K) :=\n260 |       h_congr.comp h_sum\n261 |     -- Rewrite the measures from productHaarMeasure to Measure.pi\n262 |     simpa [hprod_eq] using h_comp\n263 |   -- Step 2: C(A) × C(intSites) ≃ᵐ C(All) (for A, intSites disjoint)\n264 |   have hf2_mp : MeasurePreserving\n265 |     (((MeasurableEquiv.sumPiEquivProdPi\n266 |       (fun _ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites => SU N)).symm).trans\n267 |     (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) All => SU N)\n268 |       (finiteLinkIndexUnionSum hAI).symm))\n269 |     ((productHaarMeasure N (PeriodicSite T L) A).prod (productHaarMeasure N (PeriodicSite T L) intSites))\n270 |     (productHaarMeasure N (PeriodicSite T L) All) := by\n271 |     -- Same argument as hf1_mp\n272 |     have h_sum : MeasurePreserving\n273 |       (MeasurableEquiv.sumPiEquivProdPi\n274 |         (fun _ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites => SU N)).symm\n275 |       ((Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A) => MeasureTheory.Measure.haarMeasure K).prod\n276 |         (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) intSites) => MeasureTheory.Measure.haarMeasure K))\n277 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites) =>\n278 |         MeasureTheory.Measure.haarMeasure K) := by\n279 |       exact measurePreserving_sumPiEquivProdPi_symm (fun _ => MeasureTheory.Measure.haarMeasure K)\n280 |     have h_congr : MeasurePreserving\n281 |       (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) All => SU N)\n282 |         (finiteLinkIndexUnionSum hAI).symm)\n283 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites) =>\n284 |         MeasureTheory.Measure.haarMeasure K)\n285 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) All) => MeasureTheory.Measure.haarMeasure K) := by\n286 |       simpa [Function.comp] using\n287 |         measurePreserving_piCongrLeft (fun (_ : FiniteLinkIndex (PeriodicSite T L) All) =>\n288 |           MeasureTheory.Measure.haarMeasure K) (finiteLinkIndexUnionSum hAI).symm\n289 |     have h_comp : MeasurePreserving\n290 |       (((MeasurableEquiv.sumPiEquivProdPi\n291 |         (fun _ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites => SU N)).symm).trans\n292 |       (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) All => SU N)\n293 |         (finiteLinkIndexUnionSum hAI).symm))\n294 |       ((Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) A) => MeasureTheory.Measure.haarMeasure K).prod\n295 |         (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) intSites) => MeasureTheory.Measure.haarMeasure K))\n296 |       (Measure.pi fun (_ : FiniteLinkIndex (PeriodicSite T L) All) => MeasureTheory.Measure.haarMeasure K) :=\n297 |       h_congr.comp h_sum\n298 |     simpa [hprod_eq] using h_comp\n299 |   -- Step 3: C(posSites) × C(negSites) × C(intSites) ≃ C(A) × C(intSites) ≃ C(All) via prodAssoc\n300 |   let f1 : (FiniteLinkConfig N (PeriodicSite T L) posSites × FiniteLinkConfig N (PeriodicSite T L) negSites) ≃ᵐ\n301 |       FiniteLinkConfig N (PeriodicSite T L) A :=\n302 |     ((MeasurableEquiv.sumPiEquivProdPi\n303 |       (fun _ : FiniteLinkIndex (PeriodicSite T L) posSites ⊕ FiniteLinkIndex (PeriodicSite T L) negSites => SU N)).symm).trans\n304 |     (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) A => SU N)\n305 |       (finiteLinkIndexUnionSum hPN).symm)\n306 |   let f2 : (FiniteLinkConfig N (PeriodicSite T L) A × FiniteLinkConfig N (PeriodicSite T L) intSites) ≃ᵐ\n307 |       FiniteLinkConfig N (PeriodicSite T L) All :=\n308 |     ((MeasurableEquiv.sumPiEquivProdPi\n309 |       (fun _ : FiniteLinkIndex (PeriodicSite T L) A ⊕ FiniteLinkIndex (PeriodicSite T L) intSites => SU N)).symm).trans\n310 |     (MeasurableEquiv.piCongrLeft (fun _ : FiniteLinkIndex (PeriodicSite T L) All => SU N)\n311 |       (finiteLinkIndexUnionSum hAI).symm)\n312 |   let e : (FiniteLinkConfig N (PeriodicSite T L) posSites × FiniteLinkConfig N (PeriodicSite T L) negSites ×\n313 |       FiniteLinkConfig N (PeriodicSite T L) intSites) ≃ᵐ FiniteLinkConfig N (PeriodicSite T L) All :=\n314 |     (MeasurableEquiv.prodAssoc (α := FiniteLinkConfig N (PeriodicSite T L) posSites)\n315 |       (β := FiniteLinkConfig N (PeriodicSite T L) negSites)\n316 |       (γ := FiniteLinkConfig N (PeriodicSite T L) intSites)).symm.trans\n317 |     ((f1.prodCongr (MeasurableEquiv.refl (FiniteLinkConfig N (PeriodicSite T L) intSites))).trans f2)\n318 |   have he_mp : MeasurePreserving e\n319 |       ((productHaarMeasure N (PeriodicSite T L) posSites).prod\n320 |         ((productHaarMeasure N (PeriodicSite T L) negSites).prod (productHaarMeasure N (PeriodicSite T L) intSites)))\n321 |       (productHaarMeasure N (PeriodicSite T L) All) := by\n322 |     -- The composition of measure-preserving maps\n323 |     have h_assoc_mp : MeasurePreserving\n324 |       (MeasurableEquiv.prodAssoc (α := FiniteLinkConfig N (PeriodicSite T L) posSites)\n325 |         (β := FiniteLinkConfig N (PeriodicSite T L) negSites)\n326 |         (γ := FiniteLinkConfig N (PeriodicSite T L) intSites)).symm\n327 |       ((productHaarMeasure N (PeriodicSite T L) posSites).prod\n328 |         ((productHaarMeasure N (PeriodicSite T L) negSites).prod (productHaarMeasure N (PeriodicSite T L) intSites)))\n329 |       (((productHaarMeasure N (PeriodicSite T L) posSites).prod (productHaarMeasure N (PeriodicSite T L) negSites)).prod\n330 |         (productHaarMeasure N (PeriodicSite T L) intSites)) := by\n331 |       haveI : SFinite (productHaarMeasure N (PeriodicSite T L) negSites) := by\n332 |         have h_fin : IsFiniteMeasure (productHaarMeasure N (PeriodicSite T L) negSites) :=\n333 |           productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) negSites\n334 |         infer_instance\n335 |       haveI : SFinite (productHaarMeasure N (PeriodicSite T L) intSites) := by\n336 |         have h_fin : IsFiniteMeasure (productHaarMeasure N (PeriodicSite T L) intSites) :=\n337 |           productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) intSites\n338 |         infer_instance\n339 |       have h_forward : MeasurePreserving\n340 |         (MeasurableEquiv.prodAssoc (α := FiniteLinkConfig N (PeriodicSite T L) posSites)\n341 |           (β := FiniteLinkConfig N (PeriodicSite T L) negSites)\n342 |           (γ := FiniteLinkConfig N (PeriodicSite T L) intSites))\n343 |         (((productHaarMeasure N (PeriodicSite T L) posSites).prod (productHaarMeasure N (PeriodicSite T L) negSites)).prod\n344 |           (productHaarMeasure N (PeriodicSite T L) intSites))\n345 |         ((productHaarMeasure N (PeriodicSite T L) posSites).prod\n346 |           ((productHaarMeasure N (PeriodicSite T L) negSites).prod (productHaarMeasure N (PeriodicSite T L) intSites))) :=\n347 |         measurePreserving_prodAssoc (productHaarMeasure N (PeriodicSite T L) posSites)\n348 |           (productHaarMeasure N (PeriodicSite T L) negSites) (productHaarMeasure N (PeriodicSite T L) intSites)\n349 |       exact h_forward.symm\n350 |     have h_f1I_mp : MeasurePreserving\n351 |       (f1.prodCongr (MeasurableEquiv.refl (FiniteLinkConfig N (PeriodicSite T L) intSites)))\n352 |       (((productHaarMeasure N (PeriodicSite T L) posSites).prod (productHaarMeasure N (PeriodicSite T L) negSites)).prod\n353 |         (productHaarMeasure N (PeriodicSite T L) intSites))\n354 |       ((productHaarMeasure N (PeriodicSite T L) A).prod (productHaarMeasure N (PeriodicSite T L) intSites)) := by\n355 |       -- f1.prodCongr (refl _) is the same as Prod.map f1 id as a function\n356 |       have h_eq : (f1.prodCongr (MeasurableEquiv.refl _ : (FiniteLinkConfig N (PeriodicSite T L) intSites) ≃ᵐ _)) =\n357 |           (MeasurableEquiv.prodCongr f1 (MeasurableEquiv.refl _)) := rfl\n358 |       -- Use the map_prod_map lemma to show measure preservation\n359 |       have h_id_mp : MeasurePreserving (id : FiniteLinkConfig N (PeriodicSite T L) intSites → _)\n360 |           (productHaarMeasure N (PeriodicSite T L) intSites) (productHaarMeasure N (PeriodicSite T L) intSites) :=\n361 |         ⟨measurable_id, by\n362 |           simpa using Measure.map_id (μ := productHaarMeasure N (PeriodicSite T L) intSites)⟩\n363 |       haveI : SFinite ((productHaarMeasure N (PeriodicSite T L) posSites).prod\n364 |           (productHaarMeasure N (PeriodicSite T L) negSites)) := by\n365 |         haveI : IsFiniteMeasure (productHaarMeasure N (PeriodicSite T L) posSites) :=\n366 |           productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) posSites\n367 |         haveI : IsFiniteMeasure (productHaarMeasure N (PeriodicSite T L) negSites) :=\n368 |           productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) negSites\n369 |         infer_instance\n370 |       haveI : SFinite (productHaarMeasure N (PeriodicSite T L) intSites) := by\n371 |         have h_fin : IsFiniteMeasure (productHaarMeasure N (PeriodicSite T L) intSites) :=\n372 |           productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) intSites\n373 |         infer_instance\n374 |       have h_map_prod := Measure.map_prod_map\n375 |         ((productHaarMeasure N (PeriodicSite T L) posSites).prod (productHaarMeasure N (PeriodicSite T L) negSites))\n376 |         (productHaarMeasure N (PeriodicSite T L) intSites)\n377 |         hf1_mp.measurable measurable_id\n378 |       -- h_map_prod: (map f1 μa).prod (map id μc) = map (Prod.map f1 id) (μa.prod μc)\n379 |       have