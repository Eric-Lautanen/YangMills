55 |   This is the positive+interface reduction of G.  The extra factor of 1/2 in the\n1256 | \n1257 |   exponential (compared to G) ensures that G(U)·G(θU) factorizes as\n1258 | \n1259 |   g(U⁺,U⁰)·g(θ⁻⁰(U⁻,U⁰))·exp(-β·(S_OS⁻(U⁻)+S_OS_int(U))/2). -/\n1260 | \n1261 | noncomputable def g_posInterface (N T L : ℕ) [NeZero T] [NeZero L] (hT : Odd T) (β : ℝ)\n1262 | \n1263 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n1264 | \n1265 |     (u : PosInterfaceConfig N T L) : ℝ :=\n1266 | \n1267 |   f (extendLinkVariable N (PeriodicSite T L) (positiveSites T L ∪ interfaceSites T L) u) *\n1268 | \n1269 |     Real.exp (-β * osPositiveOfPosInterface N T L β u / 2)\n1270 | \n1271 | \n1272 | \n1273 | /-- For a full config cfg, merging its restrictions to negative and pos+interface recovers cfg. -/\n1274 | \n1275 | lemma mergeConfigurations_restore (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) :\n1276 | \n1277 |     mergeConfigurations N T L\n1278 | \n1279 |       (λ ⟨(n, μ), hn⟩ => cfg ⟨(n, μ), Finset.mem_univ n⟩)\n\n... 1694 more line(s) below (use offset=1280 to continue reading)","timestamp":1785492452,"token_count":944,"tool_call_id":"c149610d-7e9c-47d8-95e8-c273ef56ed09","full_token_estimate":640,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/TransferMatrix.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":2973,"byte_count":109419,"is_error":false,"duration_ms":0,"edit_line":null},"turn":25,"is_prune_marker":false}
