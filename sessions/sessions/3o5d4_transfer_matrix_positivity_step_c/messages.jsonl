{"id":14,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\PeterWeyl.lean\n-- 1330 lines, 70811 bytes --\n1090 | `links : P → Fin 4 → L` (every link appears in at least one plaquette), and\n1091 | link variables `g : L → SU N`, the product of plaquette Boltzmann factors\n1092 | \n1093 |     ∏_{p ∈ P} exp(c · Re Tr(g₁ · g₂ · g₃⁻¹ · g₄⁻¹))\n1094 | \n1095 | (where `g_i = g(links p i)`) decomposes as a **separable character\n1096 | decomposition**\n1097 | \n1098 |     ∑_{w : L → ι} F(w) · ∏_{l ∈ L} χ_{w(l)}(g_l)\n1099 | \n1100 | with `F(w) ≥ 0`.\n1101 | \n1102 | This is the key algebraic ingredient for the interface Boltzmann factor\n1103 | decomposition (sub-step (a) of the `transferMatrixPositivity_axiom` closure\n1104 | plan).  The proof combines the Peter-Weyl character expansion of each\n1105 | plaquette factor, the product-of-sums distributive expansion, per-term\n1106 | application of `charProduct_mixed_link_separable_decomp` (using the dual map\n1107 | to handle inverted links), and summation of non-negative coefficients.\n1108 | \n1109 | See `docs/transfer_matrix_positivity_design.md` for the full plan. -/\n1110 | lemma plaquette_product_separable_decomp\n1111 |     {ι : Type*} [Fintype ι] [DecidableEq ι] {dims : ι → ℕ}\n1112 |     (ρ : ∀ i, SU N →* Matrix (Fin (dims i)) (Fin (dims i)) ℂ)\n1113 |     (hU : ∀ i, IsUnitaryRepresentation (ρ i))\n1114 |     (coeff : ι → ι → ι → ι → ι → ℝ) (hcoeff : ∀ r s t u v, 0 ≤ coeff r s t u v)\n1115 |     (cg : ι → ι → ι → ℝ) (hcg : ∀ s t w, 0 ≤ cg s t w)\n1116 |     (hcg_decomp : ∀ s t (g : SU N),\n1117 |       repCharacter (ρ s) g * repCharacter (ρ t) g =\n1118 |       ∑ w : ι, (cg s t w : ℂ) * repCharacter (ρ w) g)\n1119 |     (dual : ι → ι) (hdual : ∀ i (g : SU N),\n1120 |       repCharacter (ρ (dual i)) g = conj (repCharacter (ρ i) g))\n1121 |     (c : ℝ) (hc : 0 ≤ c)\n1122 |     (hexp4 : ∀ g₁ g₂ g₃ g₄ : SU N,\n1123 |       (Real.exp (c * (Matrix.trace ((g₁ * g₂ * g₃ * g₄ : SU N) :\n1124 |           Matrix (Fin N) (Fin N) ℂ)).re) : ℂ) =\n1125 |         ∑ r : ι, ∑ s : ι, ∑ t : ι, ∑ u : ι, ∑ v : ι,\n1126 |           (coeff r s t u v : ℂ) *\n1127 |           (repCharacter (ρ s) g₁ * repCharacter (ρ t) g₂ *\n1128 |            repCharacter (ρ u) g₃ * repCharacter (ρ v) g₄))\n1129 |     (P : Type*) [Fintype P] [DecidableEq P]\n1130 |     (L : Type*) [Fintype L] [DecidableEq L]\n1131 |     (links : P → Fin 4 → L)\n1132 |     (hlinks_surj : ∀ l, ∃ p j, links p j = l)\n1133 |     (g : L → SU N) :\n1134 |     ∃ (F : (L → ι) → ℝ) (hF : ∀ w, 0 ≤ F w),\n1135 |       (∏ p : P, (Real.exp (c * (Matrix.trace\n1136 |           ((g (links p 0) * g (links p 1) * (g (links p 2))⁻¹ *\n1137 |            (g (links p 3))⁻¹ : SU N) :\n1138 |           Matrix (Fin N) (Fin N) ℂ)).re) : ℂ)) =\n1139 |         ∑ w : L → ι, (F w : ℂ) * ∏ l : L, repCharacter (ρ (w l)) (g l) := by\n1140 |   classical\n1141 |   -- Define the link partition: S l = {(p,j) : links p j = l}\n1142 |   let S : L → Finset (P × Fin 4) := fun l =>\n1143 |     (Finset.univ : Finset (P × Fin 4)).filter (fun x => links x.1 x.2 = l)\n1144 |   -- S l is nonempty (surjectivity of links)\n1145 |   have hS_nonempty : ∀ l, (S l).Nonempty := by\n1146 |     intro l\n1147 |     obtain ⟨p, j, hj⟩ := hlinks_surj l\n1148 |     refine ⟨(p, j), ?_⟩\n1149 |     show (p, j) ∈ (Finset.univ : Finset (P × Fin 4)).filter (fun x => links x.1 x.2 = l)\n1150 |     exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hj⟩\n1151 |   -- S l are pairwise disjoint\n1152 |   have hS_disj : Set.PairwiseDisjoint (↑(Finset.univ : Finset L)) S := by\n1153 |     intro l _ m _ hlm\n1154 |     refine Finset.disjoint_left.mpr (fun x hx => ?_)\n1155 |     obtain ⟨p, j⟩ := x\n1156 |     intro h\n1157 |     have hx2 := Finset.mem_filter.1 hx\n1158 |     have h2 := Finset.mem_filter.1 h\n1159 |     have hxl : links p j = l := hx2.2\n1160 |     have hxm : links p j = m := h2.2\n1161 |     rw [hxl] at hxm\n1162 |     exact hlm hxm\n1163 |   -- biUnion S = univ\n1164 |   have hS_biUnion : (Finset.univ : Finset L).biUnion S = Finset.univ := by\n1165 |     ext x\n1166 |     constructor\n1167 |     · intro _\n1168 |       exact Finset.mem_univ _\n1169 |     · intro _\n1170 |       obtain ⟨p, j, hj⟩ := hlinks_surj (links x.1 x.2)\n1171 |       rw [Finset.mem_biUnion]\n1172 |       refine ⟨links p j, Finset.mem_univ _, ?_⟩\n1173 |       show x ∈ (Finset.univ : Finset (P × Fin 4)).filter (fun x => links x.1 x.2 = links p j)\n1174 |       exact Finset.mem_filter.2 ⟨Finset.mem_univ _, hj.symm⟩\n1175 |   -- Per-α separable decomposition via charProduct_mixed_link_separable_decomp\n1176 |   have hdecomp_α : ∀ (α : P → ι × ι × ι × ι × ι),\n1177 |       ∃ (F : (L → ι) → ℝ) (hF : ∀ w, 0 ≤ F w),\n1178 |         ∀ (g : L → SU N),\n1179 |           (∏ l, ∏ a ∈ S l,\n1180 |             (if pwIsConj a.2 then conj (repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l))\n1181 |              else repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l))) =\n1182 |           ∑ w : L → ι, (F w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l) := by\n1183 |     intro α\n1184 |     exact charProduct_mixed_link_separable_decomp ρ hU cg hcg hcg_decomp dual hdual\n1185 |       S (fun _ a => pwCharIdx (α a.1) a.2) (fun _ a => pwIsConj a.2) hS_nonempty\n1186 |   let F_α : (P → ι × ι × ι × ι × ι) → (L → ι) → ℝ := fun α => (hdecomp_α α).choose\n1187 |   have hF_α : ∀ α w, 0 ≤ F_α α w := fun α w => (hdecomp_α α).choose_spec.choose w\n1188 |   have hF_α_decomp : ∀ α (g : L → SU N),\n1189 |       (∏ l, ∏ a ∈ S l,\n1190 |         (if pwIsConj a.2 then conj (repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l))\n1191 |          else repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l))) =\n1192 |       ∑ w : L → ι, (F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l) :=\n1193 |     fun α g => (hdecomp_α α).choose_spec.choose_spec g\n1194 |   -- Coefficient extraction helper\n1195 |   let coeffIdx (idx : ι × ι × ι × ι × ι) : ℝ :=\n1196 |     coeff idx.1 idx.2.1 idx.2.2.1 idx.2.2.2.1 idx.2.2.2.2\n1197 |   have hcoeffIdx : ∀ idx, 0 ≤ coeffIdx idx := fun idx =>\n1198 |     hcoeff idx.1 idx.2.1 idx.2.2.1 idx.2.2.2.1 idx.2.2.2.2\n1199 |   -- The explicit 4-fold character product for plaquette p with expansion index idx\n1200 |   let charProd (p : P) (idx : ι × ι × ι × ι × ι) : ℂ :=\n1201 |     repCharacter (ρ idx.2.1) (g (links p 0)) * repCharacter (ρ idx.2.2.1) (g (links p 1)) *\n1202 |     conj (repCharacter (ρ idx.2.2.2.1) (g (links p 2))) *\n1203 |     conj (repCharacter (ρ idx.2.2.2.2) (g (links p 3)))\n1204 |   -- charProd = ∏_j form (Fin 4 enumeration)\n1205 |   have h_charProd_fin4 : ∀ p idx,\n1206 |       charProd p idx =\n1207 |       ∏ j : Fin 4, (if pwIsConj j then conj (repCharacter (ρ (pwCharIdx idx j)) (g (links p j)))\n1208 |                      else repCharacter (ρ (pwCharIdx idx j)) (g (links p j))) := by\n1209 |     intro p idx\n1210 |     rw [fin4_prod_eq]\n1211 |     show charProd p idx =\n1212 |       repCharacter (ρ (pwCharIdx idx 0)) (g (links p 0)) *\n1213 |       repCharacter (ρ (pwCharIdx idx 1)) (g (links p 1)) *\n1214 |       (if pwIsConj 2 then conj (repCharacter (ρ (pwCharIdx idx 2)) (g (links p 2)))\n1215 |        else repCharacter (ρ (pwCharIdx idx 2)) (g (links p 2))) *\n1216 |       (if pwIsConj 3 then conj (repCharacter (ρ (pwCharIdx idx 3)) (g (links p 3)))\n1217 |        else repCharacter (ρ (pwCharIdx idx 3)) (g (links p 3)))\n1218 |     simp [pwCharIdx, pwIsConj, charProd]\n1219 |   -- Per-plaquette expansion: exp(...) = ∑ idx, (coeffIdx idx : ℂ) * charProd p idx\n1220 |   have h_plaq_exp : ∀ p,\n1221 |       (Real.exp (c * (Matrix.trace\n1222 |           ((g (links p 0) * g (links p 1) * (g (links p 2))⁻¹ *\n1223 |            (g (links p 3))⁻¹ : SU N) :\n1224 |           Matrix (Fin N) (Fin N) ℂ)).re) : ℂ) =\n1225 |       ∑ idx : ι × ι × ι × ι × ι, (coeffIdx idx : ℂ) * charProd p idx := by\n1226 |     intro p\n1227 |     have h := plaquette_factor_char_expansion ρ hU coeff c hexp4\n1228 |       (g (links p 0)) (g (links p 1)) (g (l