{"id":11,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 2973 lines, 109419 bytes --\n1960 | #print axioms transferMatrix_integrand_change_of_variables\n1961 | \n1962 | /-- The transfer matrix after the change of variables `U⁻ ↦ V⁺ = reflectNegToPos(U⁻)`.\n1963 | \n1964 | After applying `reflectLinkVariable_measurePreserving_between` (with\n1965 | `sourceSites = negativeSites`, `targetSites = positiveSites`) and the pointwise\n1966 | identity `transferMatrix_integrand_change_of_variables`, the transfer matrix\n1967 | becomes:\n1968 | \n1969 |     (Tψ)(u) = exp(-β·S⁺(u)/2) · ∫_{V⁺} ψ(V⁺, σ(u⁰)) ·\n1970 |               exp(-β·(S⁺(V⁺, σ(u⁰))/2 + S_int(U⁺, u⁰, reflect(V⁺)))) dμ⁺(V⁺)\n1971 | \n1972 | This is the \"reflected\" form of the transfer matrix, where the negative-time\n1973 | integral has been replaced by a positive-time integral via the measure-preserving\n1974 | reflection. -/\n1975 | noncomputable def transferMatrixReflected (ψ : PosInterfaceConfig N T L → ℝ)\n1976 |     (u : PosInterfaceConfig N T L) : ℝ :=\n1977 |   let S_plus := osPositiveOfPosInterface N T L β u\n1978 |   ∫ (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)),\n1979 |     ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n1980 |     Real.exp (-β * (S_plus / 2 +\n1981 |       osPositiveOfPosInterface N T L β\n1982 |         (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) / 2 +\n1983 |       wilsonActionOSInterface N T L β\n1984 |         (extendToFullConfig N T L (reflectPosToNeg N T L V_plus) u)))\n1985 |     ∂ haarMeasurePositive N T L\n1986 | \n1987 | set_option maxHeartbeats 1000000 in\n1988 | /-- The transfer matrix equals the reflected transfer matrix, via the change of\n1989 | variables `U⁻ ↦ V⁺ = reflectNegToPos(U⁻)`.\n1990 | \n1991 | This is the integral-level change of variables (sub-step 2 of step (b)). It applies\n1992 | `reflectLinkVariable_measurePreserving_between` (measure-preserving from μ⁻ to μ⁺)\n1993 | together with the pointwise identity `transferMatrix_integrand_change_of_variables`. -/\n1994 | lemma transferMatrix_change_of_variables (hT : Odd T)\n1995 |     (ψ : PosInterfaceConfig N T L → ℝ) (u : PosInterfaceConfig N T L)\n1996 |     (hψ_int : Integrable\n1997 |       (fun (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) =>\n1998 |         ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n1999 |         Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2000 |           osPositiveOfPosInterface N T L β\n2001 |             (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) / 2 +\n2002 |           wilsonActionOSInterface N T L β\n2003 |             (extendToFullConfig N T L (reflectPosToNeg N T L V_plus) u))))\n2004 |       (haarMeasurePositive N T L)) :\n2005 |     transferMatrixCorrect N T L β ψ u = transferMatrixReflected N T L β ψ u := by\n2006 |   -- The measure-preserving map: U⁻ ↦ V⁺ = reflectNegToPos(U⁻)\n2007 |   have hMP : MeasurePreserving (reflectNegToPos N T L)\n2008 |       (haarMeasureNegative N T L) (haarMeasurePositive N T L) := by\n2009 |     unfold haarMeasureNegative haarMeasurePositive reflectNegToPos\n2010 |     exact reflectLinkVariable_measurePreserving_between N\n2011 |       (negativeSites T L) (positiveSites T L)\n2012 |       (fun n hn => reflectSite_mem_positive_of_negative hT hn)\n2013 |       (fun n hn => reflectSite_mem_negative_of_positive hT hn)\n2014 |   -- Define the reflected integrand\n2015 |   set f_reflected := fun (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) =>\n2016 |     ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n2017 |     Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2018 |       osPositiveOfPosInterface N T L β\n2019 |         (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) / 2 +\n2020 |       wilsonActionOSInterface N T L β\n2021 |         (extendToFullConfig N T L (reflectPosToNeg N T L V_plus) u)))\n2022 |   -- Change of variables via integral_map + hMP.map_eq\n2023 |   -- integral_map gives: ∫ y, f y ∂(map g μ) = ∫ x, f (g x) ∂μ\n2024 |   -- So .symm gives: ∫ x, f (g x) ∂μ = ∫ y, f y ∂(map g μ)\n2025 |   have h_cov : ∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2026 |       f_reflected (reflectNegToPos N T L U_minus) ∂ haarMeasureNegative N T L =\n2027 |     ∫ (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)),\n2028 |       f_reflected V_plus ∂ haarMeasurePositive N T L := by\n2029 |     rw [← hMP.map_eq]\n2030 |     have h_int : Integrable f_reflected\n2031 |         (Measure.map (reflectNegToPos N T L) (haarMeasureNegative N T L)) := by\n2032 |       rw [hMP.map_eq]; exact hψ_int\n2033 |     exact (integral_map hMP.measurable.aemeasurable h_int.aestronglyMeasurable).symm\n2034 |   -- The original integrand equals f_reflected(reflectNegToPos U⁻) pointwise\n2035 |   have h_ptwise : ∀ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2036 |       ψ (reflectToPosInterface N T L U_minus (restrictToInterface N T L u)) *\n2037 |       Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2038 |         wilsonActionOSNegative N T L β (extendToFullConfig N T L U_minus u) / 2 +\n2039 |         wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus u))) =\n2040 |       f_reflected (reflectNegToPos N T L U_minus) :=\n2041 |     transferMatrix_integrand_change_of_variables N T L β hT ψ u\n2042 |   -- Assemble via calc: unfold → pointwise rewrite → change of variables → unfold\n2043 |   calc transferMatrixCorrect N T L β ψ u\n2044 |       = ∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2045 |           ψ (reflectToPosInterface N T L U_minus (restrictToInterface N T L u)) *\n2046 |           Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2047 |             wilsonActionOSNegative N T L β (extendToFullConfig N T L U_minus u) / 2 +\n2048 |             wilsonActionOSInterface N T L β (extendToFullConfig N T L U_minus u)))\n2049 |           ∂ haarMeasureNegative N T L := by\n2050 |         unfold transferMatrixCorrect; dsimp only\n2051 |     _ = ∫ (U_minus : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2052 |           f_reflected (reflectNegToPos N T L U_minus) ∂ haarMeasureNegative N T L := by\n2053 |         congr 1; funext U_minus; exact h_ptwise U_minus\n2054 |     _ = ∫ (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)),\n2055 |           f_reflected V_plus ∂ haarMeasurePositive N T L := h_cov\n2056 |     _ = transferMatrixReflected N T L β ψ u := by\n2057 |         unfold transferMatrixReflected; dsimp only\n2058 | \n2059 | #print axioms transferMatrix_change_of_variables\n2060 | \n2061 | lemma G_thetaG_factorization (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n2062 | \n2063 |     (hf_supported : dependsOnlyOnPosInterface N T L f) (U : LinkVariable (SU N) (PeriodicSite T L)) :\n2064 | \n2065 |     G N T L hT β f U * G N T L hT β f (reflectLinkVariable N U) =\n2066 | \n2067 |     g_posInterface N T L hT β f (restrictPosInterface N T L\n2068 | \n2069 |       (restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U)) *\n2070 | \n2071 |     g_posInterface N T L hT β f (reflectToPosInterface N T L\n2072 | \n2073 |       (restrictLinkVariable N (PeriodicSite T L) (negativeSites T L) U)\n2074 | \n2075 |       (restrictToInterface N T L (restrictPosInterface N T L\n2076 | \n2077 |         (restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U)))) *\n2078 | \n2079 |     Real.exp (-β * (osPositiveOfPosInterface N T L β\n\n... 894 more line(s) below (use offset=2080 to continue reading)","timestamp":1785487499,"token_count":2436,"tool_