{"id":18,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 2612 lines, 88303 bytes --\n2505 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (positiveSites T L)\n2506 |   haveI hfinN : IsFiniteMeasure muN :=\n2507 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (negativeSites T L)\n2508 |   haveI hfinI : IsFiniteMeasure muI :=\n2509 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (interfaceSites T L)\n2510 |   -- Disjointness of positive and interface sites\n2511 |   have hpi : Disjoint (positiveSites T L) (interfaceSites T L) := by\n2512 |     unfold positiveSites interfaceSites\n2513 |     rw [Finset.disjoint_filter]; intro n hn hpos hzero; linarith\n2514 |   -- Reassociation equiv rho : (Pos × (Neg × Int)) ≃ᵐ ((Pos × Int) × Neg)\n2515 |   let rho : (FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n2516 |            (FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L) ×\n2517 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L))) ≃ᵐ\n2518 |           ((FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n2519 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) ×\n2520 |            FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) :=\n2521 |     (MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm).trans\n2522 |       MeasurableEquiv.prodAssoc.symm\n2523 |   have hMPrho : MeasurePreserving rho (muP.prod (muN.prod muI)) ((muP.prod muI).prod muN) := by\n2524 |     -- rho = (prodCongr id prodComm).trans prodAssoc.symm\n2525 |     -- (a) prodCongr id swap : Pos × (Neg × Int) → Pos × (Int × Neg), measure-preserving\n2526 |     have h1 : MeasurePreserving (Prod.map id Prod.swap)\n2527 |         (muP.prod (muN.prod muI)) (muP.prod (muI.prod muN)) :=\n2528 |       MeasurePreserving.prod (MeasurePreserving.id muP) (Measure.measurePreserving_swap (μ := muN) (ν := muI))\n2529 |     -- (b) prodAssoc.symm : Pos × (Int × Neg) → (Pos × Int) × Neg, measure-preserving\n2530 |     have h2 : MeasurePreserving MeasurableEquiv.prodAssoc.symm\n2531 |         (muP.prod (muI.prod muN)) ((muP.prod muI).prod muN) :=\n2532 |       (measurePreserving_prodAssoc muP muI muN).symm\n2533 |     exact h2.comp h1\n2534 |   have hrho_symm_apply : ∀ y, rho.symm y = ⟨y.1.1, ⟨y.2, y.1.2⟩⟩ := by\n2535 |     intro y; rfl\n2536 |   -- Step 2: change of variables\n2537 |   rw [← hMP.integral_comp' H]\n2538 |   -- Step 4: reassociate via rho.symm\n2539 |   rw [← hMPrho.symm.integral_comp' (fun x => H (e x))]\n2540 |   -- Step 6: integrability (push hf_int through CoV then reassociation)\n2541 |   have hHe_int : Integrable (fun x => H (e x)) (muP.prod (muN.prod muI)) :=\n2542 |     hMP.integrable_comp_emb e.measurableEmbedding |>.mpr hf_int\n2543 |   have hInt : Integrable (fun y => H (e (rho.symm y))) ((muP.prod muI).prod muN) :=\n2544 |     hMPrho.symm.integrable_comp_emb rho.symm.measurableEmbedding |>.mpr hHe_int\n2545 |   rw [integral_prod _ hInt]\n2546 |   -- Step 5+7: inner identity\n2547 |   have hInner : ∀ (x : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n2548 |       FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)),\n2549 |       ∫ (Uneg : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2550 |         H (e (rho.symm (x, Uneg))) ∂muN =\n2551 |       g_posInterface N T L hT β f (mergePosInterface N T L x.1 x.2) *\n2552 |       transferMatrixCorrect N T L β (g_posInterface N T L hT β f) (mergePosInterface N T L x.1 x.2) := by\n2553 |     intro x\n2554 |     set m := mergePosInterface N T L x.1 x.2\n2555 |     -- Pointwise identity: for each Uneg, H (e (rho.symm (x, Uneg))) factors as g(m) * bracket\n2556 |     have hpt : ∀ (Uneg : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n2557 |         H (e (rho.symm (x, Uneg))) =\n2558 |         g_posInterface N T L hT β f m *\n2559 |           (g_posInterface N T L hT β f (reflectToPosInterface N T L Uneg (restrictToInterface N T L m)) *\n2560 |             Real.exp (-β * (osPositiveOfPosInterface N T L β m / 2 +\n2561 |               wilsonActionOSNegative N T L β (extendToFullConfig N T L Uneg m) / 2 +\n2562 |               wilsonActionOSInterface N T L β (extendToFullConfig N T L Uneg m)))) := by\n2563 |       intro Uneg\n2564 |       set U := extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n2565 |         (e (rho.symm (x, Uneg)))\n2566 |       -- restrict univ U = e (rho.symm (x, Uneg))  (extend then restrict = identity)\n2567 |       have h_ru : restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U =\n2568 |           e (rho.symm (x, Uneg)) := by\n2569 |         funext idx\n2570 |         obtain ⟨⟨n, μ⟩, hn⟩ := idx\n2571 |         simp only [restrictLinkVariable, extendLinkVariable, U, dif_pos (Finset.mem_univ n)]\n2572 |       -- restrictPosInterface (restrict univ U) = m  (via hRestrict and rho.symm structure)\n2573 |       have h_rpi : restrictPosInterface N T L\n2574 |           (restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U) = m := by\n2575 |         rw [h_ru, hRestrict (rho.symm (x, Uneg))]; rfl\n2576 |       -- restrict neg U = Uneg  (via hNeg and rho.symm structure)\n2577 |       have h_rn : restrictLinkVariable N (PeriodicSite T L) (negativeSites T L) U = Uneg := by\n2578 |         funext idx\n2579 |         obtain ⟨⟨n, μ⟩, hn⟩ := idx\n2580 |         simp only [restrictLinkVariable, extendLinkVariable, U, dif_pos (Finset.mem_univ n)]\n2581 |         rw [hNeg (rho.symm (x, Uneg)) ⟨(n, μ), hn⟩]\n2582 |         rfl\n2583 |       -- Unfold H to G U * G(θU), then apply the factorization and substitute\n2584 |       rw [show H (e (rho.symm (x, Uneg))) =\n2585 |           G N T L hT β f U * G N T L hT β f (reflectLinkVariable N U) from rfl]\n2586 |       rw [G_thetaG_factorization N T L hT β f hf_supported U]\n2587 |       rw [h