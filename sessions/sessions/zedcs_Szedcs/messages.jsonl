{"id":35,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 2612 lines, 88303 bytes --\n1246 | /-- For a full config cfg, merging its restrictions to negative and pos+interface recovers cfg. -/\n1247 | \n1248 | lemma mergeConfigurations_restore (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) :\n1249 | \n1250 |     mergeConfigurations N T L\n1251 | \n1252 |       (λ ⟨(n, μ), hn⟩ => cfg ⟨(n, μ), Finset.mem_univ n⟩)\n1253 | \n1254 |       (restrictPosInterface N T L cfg) = cfg := by\n1255 | \n1256 |   ext x\n1257 | \n1258 |   rcases x with ⟨⟨n, μ⟩, hn⟩\n1259 | \n1260 |   dsimp [mergeConfigurations, restrictPosInterface]\n1261 | \n1262 |   by_cases hpos : n ∈ positiveSites T L\n1263 | \n1264 |   · simp [hpos]\n1265 | \n1266 |   · by_cases hneg : n ∈ negativeSites T L\n1267 | \n1268 |     · simp [hpos, hneg]\n1269 | \n1270 |     · have hint : n ∈ interfaceSites T L := by\n1271 | \n1272 |         have h_cover : (positiveSites T L) ∪ (negativeSites T L) ∪ (interfaceSites T L) = Finset.univ := by\n1273 | \n1274 |           ext n'; simp [positiveSites, negativeSites, interfaceSites]\n1275 | \n1276 |           by_cases hpos' : signedTime T n'.time > 0\n1277 | \n1278 |           · simp [hpos']\n1279 | \n1280 |           · by_cases hneg' : signedTime T n'.time < 0\n1281 | \n1282 |             · simp [hpos', hneg']\n1283 | \n1284 |             · have hzero' : signedTime T n'.time = 0 := by\n1285 | \n1286 |                 have hle' : signedTime T n'.time ≤ 0 := by linarith\n1287 | \n1288 |                 have hge' : signedTime T n'.time ≥ 0 := by linarith\n1289 | \n1290 |                 linarith\n1291 | \n1292 |               simp [hpos', hneg', hzero']\n1293 | \n1294 |         have hn_univ : n ∈ Finset.univ := hn\n1295 | \n1296 |         have h_mem : n ∈ (positiveSites T L) ∪ (negativeSites T L) ∪ (interfaceSites T L) := by\n1297 | \n1298 |           rw [h_cover]; exact hn_univ\n1299 | \n1300 |         rcases Finset.mem_union.mp h_mem with (h | h)\n1301 | \n1302 |         · rcases Finset.mem_union.mp h with (h' | h')\n1303 | \n1304 |           · exfalso; exact hpos h'\n1305 | \n1306 |           · exfalso; exact hneg h'\n1307 | \n1308 |         · exact h\n1309 | \n1310 |       simp [hpos, hneg, hint]\n1311 | \n1312 | \n1313 | \n1314 | /-- For a full config cfg, the extended link variable equals extendToFullConfig of its pieces. -/\n1315 | \n1316 | lemma extend_eq_extendToFullConfig (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) :\n1317 | \n1318 |     extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg =\n1319 | \n1320 |     extendToFullConfig N T L\n1321 | \n1322 |       (λ ⟨(n, μ), hn⟩ => cfg ⟨(n, μ), Finset.mem_univ n⟩)\n1323 | \n1324 |       (restrictPosInterface N T L cfg) := by\n1325 | \n\n... 1287 more line(s) below (use offset=1326 to continue reading)","timestamp":1784915210,"token_count":891,"tool_call_id":"6c502d74-489f-4323-8993-7e649ec26618","full_token_estimate":673,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/TransferMatrix.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":2612,"byte_count":88303,"is_error":false,"duration_ms":0,"edit_line":null},"turn":19,"is_prune_marker":false}
