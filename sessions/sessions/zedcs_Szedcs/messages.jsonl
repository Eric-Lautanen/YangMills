79 |   have h_simp : (∑ i ∈ s, ∑ j ∈ s, conj (c i) * c j * φ (i⁻¹ * j)) ≥ 0 := by\n480 |     simpa [star_star] using h\n481 |   rcases Complex.nonneg_iff.mp h_simp with ⟨h_re, h_im⟩\n482 |   have h_im_zero : (∑ i ∈ s, ∑ j ∈ s, conj (c i) * c j * φ (i⁻¹ * j)).im = 0 := h_im.symm\n483 |   have h_conj_eq : conj (∑ i ∈ s, ∑ j ∈ s, conj (c i) * c j * φ (i⁻¹ * j)) =\n484 |       (∑ i ∈ s, ∑ j ∈ s, conj (c i) * c j * φ (i⁻¹ * j)) :=\n485 |     (Complex.conj_eq_iff_im.mpr h_im_zero)\n486 |   have h_target : (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * conj (φ (i⁻¹ * j))) =\n487 |       conj (∑ i ∈ s, ∑ j ∈ s, conj (c i) * c j * φ (i⁻¹ * j)) := by\n488 |     simp [map_sum, mul_comm, mul_left_comm]\n489 |   rw [h_target, h_conj_eq]\n490 |   exact h_simp\n491 | \n492 | lemma reTrace_positiveDefinite (N : ℕ) :\n493 |     PositiveDefinite (λ (g : SU N) => ((Matrix.trace (g : Matrix (Fin N) (Fin N) ℂ)).re : ℂ)) := by\n494 |   have h_trace_re_eq : ∀ (g : SU N), ((Matrix.trace (g : Matrix (Fin N) (Fin N) ℂ)).re : ℂ) =\n495 |       (fundamentalCharacter N g + conj (fundamentalCharacter N g)) / 2 := by\n496 |     intro g\n497 |     calc\n498 |       ((Matrix.trace (g : Matrix (Fin N) (Fin N) ℂ)).re : ℂ) =\n499 |         ((fundamentalCharacter N g).re : ℂ) := by simp [fundamentalCharacter]\n500 |       _ = (fundamentalCharacter N g + conj (fundamentalCharacter N g)) / 2 := by\n501 |         rw [Complex.re_eq_add_conj]\n502 |   have h_scaled : PositiveDefinite (λ (g : SU N) => (fundamentalCharacter N g + conj (fundamentalCharacter N g)) / 2) := by\n503 |     have h_sum : PositiveDefinite (λ g : SU N => fundamentalCharacter N g + conj (fundamentalCharacter N g)) :=\n504 |       PositiveDefinite.add (fundamentalCharacter_positiveDefinite N) (PositiveDefinite.conj (fundamentalCharacter_positiveDefinite N))\n505 |     have h_half_nonneg : (0 : ℝ) ≤ 1/2 := by norm_num\n506 |     have h_smul := PositiveDefinite.smul_nonneg h_half_nonneg h_sum\n507 |     simpa [div_eq_inv_mul, smul_eq_mul] using h_smul\n508 |   simpa [h_trace_re_eq] using h_scaled\n509 | \n510 | lemma exp_reTrace_positiveDefinite (N : ℕ) (c : ℝ) (hc : 0 ≤ c) :\n511 |     PositiveDefinite (λ (g : SU N) => (Real.exp (c * ((Matrix.trace (g : Matrix (Fin N) (Fin N) ℂ)).re : ℝ)) : ℂ)) := by\n512 |   set h : SU N → ℝ := fun g => (Matrix.trace (g : Matrix (Fin N) (Fin N) ℂ)).re\n513 |   set f : SU N → ℂ := fun g => (h g : ℂ)\n514 |   have hf : PositiveDefinite f := by\n515 |     have := reTrace_positiveDefinite N\n516 |     convert this using 1\n517 |   set S : ℕ → SU N → ℂ := fun n g =>\n518 |     ∑ k ∈ Finset.range n, ((c ^ k / k.factorial : ℝ) : ℂ) * ((f ^ k) g)\n519 |   have hS_PD : ∀ n, PositiveDefinite (S n) := by\n520 |     intro n\n521 |     induction n with\n522 |     | zero => simp [S, Finset.sum_empty]; exact PositiveDefinite.zero\n523 |     | succ n ih =>\n524 |       have hterm : PositiveDefinite (λ g => ((c ^ n / n.factorial : ℝ) : ℂ) * ((f ^ n) g)) := by\n525 |         apply PositiveDefinite.smul_nonneg\n526 |         · exact div_nonneg (pow_nonneg hc n) (Nat.cast_nonneg _)\n527 |         · exact PositiveDefinite.pow hf n\n528 |       have hadd : PositiveDefinite (λ g => S n g + ((c ^ n / n.factorial : ℝ) : ℂ) * ((f ^ n) g)) :=\n529 |         PositiveDefinite.add ih hterm\n530 |       have heq : S (n + 1) = (λ g => S n g + ((c ^ n / n.factorial : ℝ) : ℂ) * ((f ^ n) g)) := by\n531 |         funext g\n532 |         simp only [S, Finset.sum_range_succ]\n533 |       rw [heq]\n534 |       exact hadd\n535 |   have hS_tendsto : ∀ g, Tendsto (fun n => S n g) atTop (nhds ((Real.exp (c * h g)) : ℂ)) := by\n536 |     intro g\n537 |     have hexp : HasSum (fun k => (c * h g) ^ k / k.factorial) (Real.exp (c * h g)) := by\n538 |       have := NormedSpace.expSeries_div_hasSum_exp (c * h g)\n539 |       rwa [← Real.exp_eq_exp_ℝ] at this\n540 |     have hT_tendsto : Tendsto (fun n => ∑ k ∈ Finset.range n, (c * h g) ^ k / k.factorial) atTop\n541 |         (nhds (Real.exp (c * h g))) := hexp.tendsto_sum_