{"id":24,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 2612 lines, 88303 bytes --\n2466 | lemma integral_G_thetaG_eq_inner_g_Tg (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n2467 | \n2468 |     (hf : Measurable f) (hf_supported : dependsOnlyOnPosInterface N T L f)\n2469 | \n2470 |     (hf_int : Integrable\n2471 | \n2472 |       (fun (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n2473 | \n2474 |         G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n2475 | \n2476 |         G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg)))\n2477 | \n2478 |       (productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)))) :\n2479 | \n2480 |     (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2481 | \n2482 |       G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n2483 | \n2484 |       G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n2485 | \n2486 |       ∂ productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =\n2487 | \n2488 |     (∫ (u : PosInterfaceConfig N T L),\n2489 | \n2490 |       g_posInterface N T L hT β f u * (transferMatrixCorrect N T L β (g_posInterface N T L hT β f) u)\n2491 | \n2492 |       ∂ haarMeasurePosInterface N T L) := by\n2493 |   -- Step 1: the measure-preserving equiv\n2494 |   obtain ⟨e, ⟨hMP, hRestrict⟩, hNeg⟩ := measure_factorization' N T L\n2495 |   -- Measure abbreviations (after obtain so they also rewrite inside hMP)\n2496 |   set muP := haarMeasurePositive N T L\n2497 |   set muN := haarMeasureNegative N T L\n2498 |   set muI := haarMeasureInterface N T L\n2499 |   set mu0 := productHaar