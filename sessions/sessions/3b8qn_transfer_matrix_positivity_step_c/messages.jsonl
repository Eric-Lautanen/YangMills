(pwCharIdx (α a.1) a.2)) (g l)) := by\n1236 |     intro α\n1237 |     -- Step a: charProd p (α p) = ∏_j form\n1238 |     have h1 : ∏ p : P, charProd p (α p) =\n1239 |         ∏ p : P, ∏ j : Fin 4,\n1240 |           (if pwIsConj j then conj (repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j)))\n1241 |            else repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j))) := by\n1242 |       refine Finset.prod_congr rfl (fun p _ => h_charProd_fin4 p (α p))\n1243 |     -- Step b: ∏ p, ∏ j = ∏ (p,j) : P × Fin 4\n1244 |     have h2 : ∏ p : P, ∏ j : Fin 4,\n1245 |           (if pwIsConj j then conj (repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j)))\n1246 |            else repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j))) =\n1247 |         ∏ x : P × Fin 4,\n1248 |           (if pwIsConj x.2 then conj (repCharacter (ρ (pwCharIdx (α x.1) x.2)) (g (links x.1 x.2)))\n1249 |            else repCharacter (ρ (pwCharIdx (α x.1) x.2)) (g (links x.1 x.2))) := by\n1250 |       exact (Fintype.prod_prod_type' (fun p j =>\n1251 |         (if pwIsConj j then conj (repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j)))\n1252 |          else repCharacter (ρ (pwCharIdx (α p) j)) (g (links p j))))).symm\n1253 |     -- Step c: ∏ (p,j) = ∏ l, ∏ a ∈ S l\n1254 |     have h3 : ∏ x : P × Fin 4,\n1255 |           (if pwIsConj x.2 then conj (repCharacter (ρ (pwCharIdx (α x.1) x.2)) (g (links x.1 x.2)))\n1256 |            else repCharacter (ρ (pwCharIdx (α x.1) x.2)) (g (links x.1 x.2))) =\n1257 |         ∏ l : L, ∏ a ∈ S l,\n1258 |           (if pwIsConj a.2 then conj (repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l))\n1259 |            else repCharacter (ρ (pwCharIdx (α a.1) a.2)) (g l)) := by\n1260 |       rw [← hS_biUnion, Finset.prod_biUnion hS_disj]\n1261 |       refine Finset.prod_congr rfl (fun l _ => ?_)\n1262 |       refine Finset.prod_congr rfl (fun a ha => ?_)\n1263 |       have ha' : links a.1 a.2 = l := (Finset.mem_filter.1 ha).2\n1264 |       rw [ha']\n1265 |     rw [h1, h2, h3]\n1266 |   -- Product of sums = sum of products (Stage 2)\n1267 |   -- Define the overall coefficient F(w) = ∑ α, (∏ p, coeffIdx (α p)) * F_α α w\n1268 |   refine ⟨fun w => ∑ α : P → ι × ι × ι × ι × ι,\n1269 |             (∏ p : P, coeffIdx (α p)) * F_α α w,\n1270 |           fun w => ?_, ?_⟩\n1271 |   · -- Non-negativity: F(w) = ∑ α, (∏ p, coeffIdx (α p)) * F_α α w ≥ 0\n1272 |     exact Finset.sum_nonneg (fun α _ => mul_nonneg\n1273 |       (Finset.prod_nonneg (fun p _ => hcoeffIdx (α p)))\n1274 |       (hF_α α w))\n1275 |   · -- Equality: ∏ p, exp(...) = ∑ w, (F w : ℂ) * ∏ l, χ_{w(l)}(g_l)\n1276 |     -- Step 1: per-plaquette expansion\n1277 |     rw [show (∏ p : P, (Real.exp (c * (Matrix.trace\n1278 |         ((g (links p 0) * g (links p 1) * (g (links p 2))⁻¹ *\n1279 |          (g (links p 3))⁻¹ : SU N) :\n1280 |         Matrix (Fin N) (Fin N) ℂ)).re) : ℂ)) =\n1281 |       ∏ p : P, ∑ idx, (coeffIdx idx : ℂ) * charProd p idx from\n1282 |       Finset.prod_congr rfl (fun p _ => h_plaq_exp p)]\n1283 |     -- Step 2: product of sums = sum of products (Fintype.prod_sum)\n1284 |     rw [Fintype.prod_sum (fun p idx => (coeffIdx idx : ℂ) * charProd p idx)]\n1285 |     -- Per-α: split product + regroup by link + separable decomposition\n1286 |     have h_per_α : ∀ (α : P → ι × ι × ι × ι × ι),\n1287 |         ∏ p : P, (coeffIdx (α p) : ℂ) * charProd p (α p) =\n1288 |         (∏ p : P, (coeffIdx (α p) : ℂ)) *\n1289 |         ∑ w : L → ι, (F_α α w : ℂ) * ∏ l : L, repCharacter (ρ (w l)) (g l) := by\n1290 |       intro α\n1291 |       rw [Finset.prod_mul_distrib]\n1292 |       congr 1\n1293 |       rw [h_regroup α, hF_α_decomp α g]\n1294 |     -- Apply per-α transformation\n1295 |     simp only [h_per_α]\n1296 |     -- Stage 5: sum and collect\n1297 |     -- Step 1: distribute product over inner sum\n1298 |     have h1 : (∑ α, (∏ p, (coeffIdx (α p) : ℂ)) *\n1299 |         ∑ w, (F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l)) =\n1300 |         ∑ α, ∑ w, (∏ p, (coeffIdx (α p) : ℂ)) *\n1301 |           ((F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l)) := by\n1302 |       refine Finset.sum_congr rfl (fun α _ => ?_)\n1303 |       rw [Finset.mul_sum]\n1304 |     -- Step 2: exchange sums\n1305 |     have h2 : (∑ α, ∑ w, (∏ p, (coeffIdx (α p) : ℂ)) *\n1306 |           ((F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l))) =\n1307 |         ∑ w, ∑ α, (∏ p, (coeffIdx (α p) : ℂ)) *\n1308 |           ((F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l)) := by\n1309 |       exact Finset.sum_comm\n1310 |     -- Step 3: factor out ∏ l, χ_{w(l)}(g_l)\n1311 |     have h3 : (∑ w, ∑ α, (∏ p, (coeffIdx (α p) : ℂ)) *\n1312 |           ((F_α α w : ℂ) * ∏ l, repCharacter (ρ (w l)) (g l))) =\n1313 |         ∑ w, (∑ α, (∏ p, (coeffIdx (α p) : ℂ)) * (F_α α w : ℂ)) *\n1314 |           ∏ l, repCharacter (ρ (w l)) (g l) := by\n1315 |       refine Finset.sum_congr rfl (fun w _ => ?_)\n1316 |       rw [Finset.sum_mul]\n1317 |       refine Finset.sum_congr rfl (fun α _ => ?_)\n1318 |       ring\n1319 |     -- Combine: after h1, h2, h3 the LHS is ∑ w, (∑ α, (∏ p, ↑coeff) * ↑F_α) * ∏ l, χ\n1320 |     -- and the RHS is ∑ w, (F w : ℂ) * ∏ l, χ where F w beta-reduces to\n1321 |     -- ∑ α, (∏ p, coeffIdx (α p)) * F_α α w.  The coercion (F w : ℂ) = ↑(∑ α, ...)\n1322 |     -- unfolds via Complex.ofReal_sum/mul/prod to match the distributed LHS.\n1323 |     rw [h1, h2, h3]\n1324 |     simp only [Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_prod]\n1325 | \n1326 | #print axioms plaquette_product_separable_decomp\n1327 | \n1328 | end PlaquetteBoltzmann\n1329 | \n\n... 1 more line(s) below (use offset=1330 to continue reading)","timestamp":1785484000,"token_count":4183,"tool_call_id":"51f700e9-c0ac-497b-8a51-21675473e5c0","full_token_estimate":2866,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/PeterWeyl.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":1330,"byte_count":70811,"is_error":false,"duration_ms":0,"edit_line":null