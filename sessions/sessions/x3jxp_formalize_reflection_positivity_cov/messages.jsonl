{"id":62,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\PositiveDefinite.lean\n-- 2566 lines, 134226 bytes --\n40 | open scoped ComplexOrder\n41 | \n42 | namespace YangMills\n43 | \n44 | /-- A function φ : G → ℂ is positive-definite. -/\n45 | def PositiveDefinite {G : Type*} [Group G] (φ : G → ℂ) : Prop :=\n46 |   ∀ (s : Finset G) (c : G → ℂ),\n47 |     (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * φ (i⁻¹ * j)) ≥ 0\n48 | \n49 | section BasicProperties\n50 | \n51 | variable {G : Type*} [Group G] {φ ψ : G → ℂ}\n52 | \n53 | lemma PositiveDefinite.add (hφ : PositiveDefinite φ) (hψ : PositiveDefinite ψ) :\n54 |     PositiveDefinite (λ g => φ g + ψ g) := by\n55 |   intro s c\n56 |   have h1 := hφ s c\n57 |   have h2 := hψ s c\n58 |   have hsum : (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * ((λ g => φ g + ψ g) (i⁻¹ * j))) =\n59 |       (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * φ (i⁻¹ * j)) +\n60 |       (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * ψ (i⁻¹ * j)) := by\n61 |     simp [Finset.sum_add_distrib, mul_add]\n62 |   rw [hsum]\n63 |   exact add_nonneg h1 h2\n64 | \n65 | lemma PositiveDefinite.smul_nonneg {r : ℝ} (hr : 0 ≤ r) (hφ : PositiveDefinite φ) :\n66 |     PositiveDefinite (λ g => (r : ℂ) * φ g) := by\n67 |   intro s c\n68 |   have h := hφ s c\n69 |   have hsum : (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * ((r : ℂ) * φ (i⁻¹ * j))) =\n70 |       (r : ℂ) * (∑ i ∈ s, ∑ j ∈ s, c i * conj (c j) * φ (i⁻¹ * j)) := by\n71 |     simp [Finset.mul_sum, mul_assoc, mul_comm, mul_left_comm]\n72 |   rw [hsum]\n73 |   have h_nonneg_complex : (0 : ℂ) ≤ (r : ℂ) := by\n74 |     rw [Complex.nonneg_iff]\n75 |     constructor\n76 |     · simpa using hr\n77 |     · simp\n78 |   exact mul_nonneg h_nonneg_complex h\n79 | \n80 | /-- A positive-definite function satisfies φ(g⁻¹) = conj(φ(g)). -/\n81 | lemma PositiveDefinite.conj_inv (hφ : PositiveDefinite φ) : ∀ g, φ g⁻¹ = conj (φ g) := by\n82 |   intro g\n83 |   classical\n84 |   have h_one : 0 ≤ φ (1 : G) := by\n85 |     have h := hφ (Finset.cons 1 ∅ (by simp)) (fun _ => 1)\n86 |     simp [Finset.sum_empty] at h\n87 |     exact h\n88 |   have h_one_im : (φ (1 : G)).im = 0 := (Complex.nonneg_iff.mp h_one).2.symm\n89 |   by_cases hg : g = 1\n90 |   · subst hg; rw [inv_one]; exact (Complex.conj_eq_iff_im.mpr h_one_im).symm\n91 |   · have hS : ∀ t : ℂ, 0 ≤ (1 + t * conj t) * φ (1 : G) + conj t * φ g + t * φ g⁻¹ := by\n92 |       intro t\n93 |       have hne1 : (g : G) ∉ (∅ : Finset G) := by simp\n94 |       have hne2 : (1 : G) ∉ Finset.cons g ∅ hne1 := by simp [Ne.symm hg]\n95 |       have h := hφ (Finset.cons 1 (Finset.cons g ∅ hne1) hne2) (fun x => if x = 1 then 1 else t)\n96 |       have hsum : (∑ i ∈ Finset.cons 1 (Finset.cons g ∅ hne1) hne2,\n97 |           ∑ j ∈ Finset.cons 1 (Finset.cons g ∅ hne1) hne2,\n98 |           (if i = 1 then 1 else t) * conj (if j = 1 then 1 else t) * φ (i⁻¹ * j)) =\n99 |           (1 + t * conj t) * φ (1 : G) + conj t * φ g + t * φ g⁻¹ := by\n\n... 2467 more line(s) below (use offset=100 to continue reading)\nTime: 2026-08-10 01:16:18 UTC","timestamp":1786324578,"token_count":915,"tool_call_id":"ef70e602-969c-48fb-acd4-283b62665ed0","full_token_estimate":693,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/PositiveDefinite.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":2566,"byte_count":134226,"is_error":false,"duration_ms":0,"edit_line":null},"turn":45,"is_prune_marker":false}
