{"id":25,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\LatticeMeasure.lean\n-- 935 lines, 53804 bytes --\n380 | \n381 | The reflection `θ` acts by `(θU)(n, μ) = U(θn, μ)⁻¹` for time-like links (μ = 0)\n382 | and `(θU)(n, μ) = U(θn, μ)` for spatial links (μ ≠ 0).  This is a composition of:\n383 | 1. An index permutation `(n, μ) ↦ (θn, μ)` — preserves the product measure since\n384 |    all factors are identical.\n385 | 2. Componentwise inversion on time-like links — preserves the product measure\n386 |    since the Haar measure on `SU(N)` is inversion-invariant\n387 |    (`haarMeasure_inv_invariant`).\n388 | \n389 | Both steps preserve the product Haar measure, so the composition does too.\n390 | \n391 | This is the key measure-theoretic ingredient for the character-orthogonality\n392 | approach to closing `transferMatrixPositivity_axiom`: it justifies the change\n393 | of variables `U ↦ θU` in the reflection-positivity integral.\n394 | \n395 | The reflection `θ` acts by `(θU)(n, μ) = U(θn, μ)⁻¹` for time-like links (μ = 0)\n396 | and `(θU)(n, μ) = U(θn, μ)` for spatial links (μ ≠ 0).  This is a composition of:\n397 | 1. An index permutation `(n, μ) ↦ (θn, μ)` — preserves the product measure since\n398 |    all factors are identical (`measurePreserving_piCongrLeft`).\n399 | 2. Componentwise inversion on time-like links — preserves the product measure\n400 |    since the Haar measure on `SU(N)` is inversion-invariant\n401 |    (`haarMeasure_inv_invariant`).\n402 | \n403 | Both steps preserve the product Haar measure, so the composition does too\n404 | (`MeasurePreserving.comp`).\n405 | \n406 | This is the key measure-theoretic ingredient for the character-orthogonality\n407 | approach to closing `transferMatrixPositivity_axiom`: it justifies the change\n408 | of variables `U ↦ θU` in the reflection-positivity integral.\n409 | \n410 | The hypothesis `hsites : ∀ n, n ∈ sites → reflectSite n ∈ sites` is necessary:\n411 | since `ReflectSite.involution` makes `reflectSite` involutive, it makes the\n412 | reflection a bijection on `sites`, so the index permutation is a genuine\n413 | permutation of `FiniteLinkIndex Λ sites`.  Without it, an out-of-`sites`\n414 | reflection would collapse a Haar-distributed degree of freedom to the constant\n415 | `1` (via `extendLinkVariable`'s default), which does *not* preserve the product\n416 | Haar measure. -/\n417 | lemma reflectLinkVariable_measurePreserving\n418 |     (N : ℕ) {Λ : Type} [DecidableEq Λ] [ReflectSite Λ]\n419 |     (sites : Finset Λ)\n420 |     (hsites : ∀ n, n ∈ sites → ReflectSite.reflectSite n ∈ sites) :\n421 |     MeasurePreserving\n422 |       (fun (cfg : FiniteLinkConfig N Λ sites) =>\n423 |         restrictLinkVariable N Λ sites\n424 |           (reflectLinkVariable N (extendLinkVariable N Λ sites cfg)))\n425 |       (productHaarMeasure N Λ sites) (productHaarMeasure N Λ sites) := by\n426 |   -- The positive compact set used to build the Haar measure on SU(N),\n427 |   -- matching the one in `productHaarMeasure`.\n428 |   let K : TopologicalSpace.PositiveCompacts (SU N) :=\n429 |     ⟨⟨Set.univ, isCompact_univ⟩, by simpa using Set.univ_nonempty (α := SU N)⟩\n430 |   set ν : Measure (SU N) := MeasureTheory.Measure.haarMeasure K with hν_def\n431 |   -- `productHaarMeasure` is the product of identical Haar factors.\n432 |   have hμ : productHaarMeasure N Λ sites =\n433 |       Measure.pi (fun _ : FiniteLinkIndex Λ sites => ν) := by\n434 |     simp only [productHaarMeasure, ν, K, hν_def]\n435 |   -- The index permutation `(n, μ) ↦ (reflectSite n, μ)` on `FiniteLinkIndex`.\n436 |   -- It is involutive (hence a bijection) thanks to `ReflectSite.involution`.\n437 |   let perm : FiniteLinkIndex Λ sites ≃ FiniteLinkIndex Λ sites :=\n438 |     { toFun := fun ⟨⟨n, μ⟩, hn⟩ => ⟨⟨ReflectSite.reflectSite n, μ⟩, hsites n hn⟩\n439 |       invFun := fun ⟨⟨n, μ⟩, hn⟩ => ⟨⟨ReflectSite.reflectSite n, μ⟩, hsites n hn⟩\n440 |       left_inv := fun ⟨⟨n, μ⟩, hn⟩ => by\n441 |         simp only [ReflectSite.involution]\n442 |         rfl\n443 |       right_inv := fun ⟨⟨n, μ⟩, hn⟩ => by\n444 |         simp only [ReflectSite.involution]\n445 |         rfl }\n446 |   -- Step 1: the index permutation preserves the product measure.\n447 |   -- `MeasurableEquiv.piCongrLeft (fun _ => SU N) perm.symm` acts, with the\n448 |   -- constant fibre `SU N`, as `cfg ↦ fun i => cfg (perm i)`.\n449 |   have h_perm : MeasurePreserving\n450 |       (MeasurableEquiv.piCongrLeft (fun _ => SU N) perm.symm)\n451 |       (Measure.pi (fun _ : FiniteLinkIndex Λ sites => ν))\n452 |       (Measure.pi (fun _ : FiniteLinkIndex Λ sites => ν)) :=\n453 |     measurePreserving_piCongrLeft (fun _ => ν) perm.symm\n454 |   -- With the constant fibre `SU N`, the `piCongrLeft` application simplifies\n455 |   -- to `cfg (perm i)` (the dependent transport is over a constant motive).\n456 |   have h_perm_eq : ∀ (cfg : FiniteLinkConfig N Λ sites) (i : FiniteLinkIndex Λ sites),\n457 |       MeasurableEquiv.piCongrLeft (fun _ => SU N) perm.symm cfg i = cfg (perm i) := by\n458 |     intro cfg i\n459 |     have h := @MeasurableEquiv.piCongrLeft_apply_apply _ _ perm.symm\n460 |       (fun _ => SU N) _ cfg (perm i)\n461 |     rwa [Equiv.symm_apply_apply] at h\n462 |   -- product measure, since each factor is either `id` (spatial) or `Inv.inv`\n463 |   -- (time-like), and the Haar measure is inversion-invariant.\n464 |   have h_inv : MeasurePreserving\n465 |       (fun (cfg : FiniteLinkConfig N Λ sites) (i : FiniteLinkIndex Λ sites) =>\n466 |         if i.1.2 = 0 then (cfg i)⁻¹ else cfg i)\n467 |       (Measure.pi (fun _ : FiniteLinkIndex Λ sites => ν))\n468 |       (Measure.pi (fun _ : FiniteLinkIndex Λ sites => ν)) := by\n469 |     have h := measurePreserving_pi (fun _ : FiniteLinkIndex Λ sites => ν) (fun _ => ν)\n470 |       (f := fun i => if i.1.2 = 0 then (Inv.inv : SU N → SU N) else id)\n471 |       (by\n472 |         intro i\n473 |         by_cases h : i.1.2 = 0\n474 |         · simp only [h, ↓reduceIte]\n475 |           exact ⟨continuous_inv.measurable, haarMeasure_inv_invariant N⟩\n476 |         · simp only [h, ↓reduceIte]\n477 |           exact MeasurePreserving.id ν)\n478 |     convert h using 1\n479 |     funext cfg i\n480 |     by_cases h : i.1.2 = 0 <;> simp only [h, ↓reduceIte, Function.id_def]\n481 |   -- Compose the two measure-preserving maps.\n482 |   have h_comp := h_inv.comp h_perm\n483 |   -- The stated map equals the composition: at `(n, μ)` with `n ∈ sites`,\n484 |   -- `hsites` forces `reflectSite n ∈ sites`, so the out-of-`sites` default\n485 |   -- never triggers, and the map reduces to the permutation followed by the\n486 |   -- componentwise (id/inv) operation.\n487 |   have h_eq :\n488 |       (fun (cfg : FiniteLinkConfig N Λ sites) =>\n489 |         restrictLinkVariable N Λ sites\n490 |           (reflectLinkVariable N (extendLinkVariable N Λ sites cfg))) =\n491 |       (fun cfg i =>\n492 |         if i.1.2 = 0 then (MeasurableEquiv.piCongrLeft (fun _ => SU N) perm.symm cfg i)⁻¹\n493 |         else MeasurableEquiv.piCongrLeft (fun _ => SU N) perm.symm cfg i) := by\n494 |     funext cfg i\n495 |     rcases i with ⟨⟨n, μ⟩, hn⟩\n496 |     simp only [restrictLinkVariable, reflectLinkVariable, extendLinkVariable,\n497 |       dif_pos (hsites n hn)]\n498 |     rw [h_perm_eq cfg ⟨(n, μ), hn⟩]\n499 |     rfl\n500 |   rw [hμ, h_eq]\n501 |   exact h_comp\n502 | \n503 | /-- The reflection maps link configs on `sourceSites` to link configs on `targetSites`\n504 | in a measure-preserving way, when `reflectSite` gives a bijection between the two\n505 | site sets (via `h_reflect` and `h_reflect_inv`).\n506 | \n507 | This generalizes `reflectLinkVariable_measurePreserving` (which is the special case\n508 | `sourceSites = targetSites = sites` with `h_reflect = h_reflect_inv = hsites`).\n509 | \n510 | The key application is the change of variables `U⁻ ↦ V⁺ = reflect(U⁻)` in the\n511 | transfer-matrix integral (step (b) of the 