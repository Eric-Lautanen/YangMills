{"id":15,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 6055 lines, 297949 bytes --\n2619 | lemma transferMatrix_change_of_variables (hT : Odd T)\n2620 |     (ψ : PosInterfaceConfig N T L → ℝ) (u : PosInterfaceConfig N T L)\n2621 |     (hψ_int : Integrable\n2622 |       (fun (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) =>\n2623 |         ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n2624 |         Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2625 |           osPositiveOfPosInterface N T L β\n2626 |             (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) / 2 +\n2627 |           wilsonActionOSInterface N T L β\n2628 |             (extendToFullConfig N T L (reflectPosToNeg N T L V_plus) u))))\n2629 |       (haarMeasurePositive N T L)) :\n2630 |     transferMatrixCorrect N T L β ψ u = transferMatrixReflected N T L β ψ u := by\n2631 |   -- The measure-preserving map: U⁻ ↦ V⁺ = reflectNegToPos(U⁻)\n2632 |   have hMP : MeasurePreserving (reflectNegToPos N T L)\n2633 |       (haarMeasureNegative N T L) (haarMeasurePositive N T L) := by\n2634 |     unfold haarMeasureNegative haarMeasurePositive reflectNegToPos\n2635 |     exact reflectLinkVariable_measurePreserving_between N\n2636 |       (negativeSites T L) (positiveSites T L)\n2637 |       (fun n hn => reflectSite_mem_positive_of_negative hT hn)\n2638 |       (fun n hn => reflectSite_mem_negative_of_positive hT hn)\n2639 |   -- Define the reflected integrand\n2640 |   set f_reflected := fun (V_plus : FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L)) =>\n2641 |     ψ (mergePosInterface N T L V_plus (sigmaInterface N T L (restrictToInterface N T L u))) *\n2642 |     Real.exp (-β * (osPositiveOfPosInterface N T L β u / 2 +\n2643 |       osPositiveOfPosInterface N T L β\n2644 |         (mergePosInterface N T L V_plus (sigmaInterface N T L (re