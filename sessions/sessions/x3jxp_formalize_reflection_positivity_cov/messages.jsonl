{"id":34,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\ReflectionPositivity.lean\n-- 2947 lines, 172452 bytes --\n430 | The temporal-link inversion `σ` (which inverts `μ = 0` links at the interface)\n431 | is the sole obstacle; restricting `f` to spatial interface links removes it.\n432 | \n433 | See `docs/transfer_matrix_positivity_design.md` §8.11.36 for the full analysis. -/\n434 | def dependsOnlyOnPosSpatialInterface (N T L : ℕ) [NeZero T] [NeZero L]\n435 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ) : Prop :=\n436 |   ∀ (U V : LinkVariable (SU N) (PeriodicSite T L)),\n437 |     (∀ (n : PeriodicSite T L) (μ : Fin 4),\n438 |       n ∈ positiveSites T L ∨ (n ∈ interfaceSites T L ∧ μ ≠ (0 : Fin 4)) →\n439 |       U.value n μ = V.value n μ) → f U = f V\n440 | \n441 | /-- `dependsOnlyOnPosSpatialInterface` is stronger than `dependsOnlyOnPosInterface`:\n442 | if `f` ignores temporal interface links, it certainly ignores all links outside\n443 | the positive+interface region. -/\n444 | lemma dependsOnlyOnPosSpatialInterface.dependsOnlyOnPosInterface\n445 |     (N T L : ℕ) [NeZero T] [NeZero L]\n446 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n447 |     (hf : dependsOnlyOnPosSpatialInterface N T L f) :\n448 |     dependsOnlyOnPosInterface N T L f := by\n449 |   intro U V hUV\n450 |   apply hf\n451 |   intro n μ hn\n452 |   rcases hn with hpos | ⟨hint, hμ⟩\n453 |   · exact hUV n μ (Finset.mem_union_left _ hpos)\n454 |   · exact hUV n μ (Finset.mem_union_right _ hint)\n455 | \n456 | /-! ### Osterwalder-Seiler decomposition (plaquette-based) -/\n457 | open scoped BigOperators\n458 | \n459 | /-- Index type for oriented plaquettes on a periodic lattice: (base site, μ, ν). -/\n460 | abbrev PlaquetteIndex (T L : ℕ) : Type := PeriodicSite T L × Fin 4 × Fin 4\n461 | \n462 | instance (T L : ℕ) [NeZero T] [NeZero L] : Fintype (PlaquetteIndex T L) :=\n463 |   inferInstanceAs (Fintype (PeriodicSite T L × Fin 4 × Fin 4))\n464 | \n465 | /-- Cyclic permutation of trace for 4 matrices: Tr(ABCD) = Tr(BCDA). -/\n466 | lemma trace_cyclic_four (N : ℕ) (A B C D : Matrix (Fin N) (Fin N) ℂ) :\n467 |     Matrix.trace (A * B * C * D) = Matrix.trace (B * C * D * A) := by\n468 |   calc\n469 |     Matrix.trace (A * B * C * D) = Matrix.trace (D * (A * B * C)) := by\n470 |       rw [Matrix.trace_mul_comm (A * B * C) D]\n471 |     _ = Matrix.trace (D * A * B * C) := by noncomm_ring\n472 |     _ = Matrix.trace ((D * A) * (B * C)) := by noncomm_ring\n473 |     _ = Matrix.trace ((B * C) * (D * A)) := Matrix.trace_mul_comm (D * A) (B * C)\n474 |     _ = Matrix.trace (B * C * D * A) := by noncomm_ring\n475 | /-- For A ∈ SU(N), Re Tr(A) = Re Tr(A⁻¹). -/\n476 | lemma trace_re_inv (N : ℕ) (A : SU N) :\n477 |     ((Matrix.trace ((A : Matrix (Fin N) (Fin N) ℂ))).re : ℝ) =\n478 |     ((Matrix.trace (((A⁻¹ : SU N) : Matrix (Fin N) (Fin N) ℂ))).re : ℝ) := by\n479 |   have hstar : (A⁻¹ : SU N) = (star A : SU N) := by\n480 |     simpa using (Matrix.star_eq_inv (A : SU N)).symm\n481 |   have h_trace_star : Matrix.trace (star ((A : Matrix (Fin N) (Fin N) ℂ))) =\n482 |       star (Matrix.trace ((A : Matrix (Fin N) (Fin N) ℂ))) := by\n483 |     simp [Matrix.trace, map_sum]\n484 |   calc\n485 |     ((Matrix.trace ((A : Matrix (Fin N) (Fin N) ℂ))).re : ℝ) =\n486 |         ((star (Matrix.trace ((A : Matrix (Fin N) (Fin N) ℂ)))).re : ℝ) := by simp\n487 |     _ = ((Matrix.trace (star ((A : Matrix (Fin N) (Fin N) ℂ)))).re : ℝ) := by\n488 |       simp [h_trace_star]\n489 |     _ = ((Matrix.trace (((A⁻¹ : SU N) : Matrix (Fin N) (Fin N) ℂ))).re : ℝ) := by simp [hstar]\n\n... 2458 more line(s) below (use offset=490 to continue reading)\nTime: 2026-08-10 00:49:58 UTC","timestamp":1786322998,"token_count":1124,"tool_call_id":"e0b2dc0f-9c88-4002-bcc1-ad58aef19c8d","full_token_estimate":764,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/ReflectionPositivity.lean","old_text":null,"new_text":null,"exit_code":null,"li