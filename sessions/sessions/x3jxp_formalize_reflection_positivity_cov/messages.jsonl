2658 |     (hf_supported : dependsOnlyOnPosSpatialInterface N T L f) :\n2659 |     0 ≤ gibbsExpectation N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n2660 |       (λ U => f U * reflectObservable N f U) := by\n2661 |   dsimp [gibbsExpectation]\n2662 |   have hZ_pos : partitionFunctionFinite N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) > 0 :=\n2663 |     partitionFunctionFinite_pos N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n2664 |   refine div_nonneg ?_ (le_of_lt hZ_pos)\n2665 |   set μ₀ := productHaarMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hμ₀\n2666 |   set S_total := wilsonActionFiniteConfig N β (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hS\n2667 |   set U_ext := extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) with hU\n2668 |   have h_total_decomp : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2669 |       S_total cfg = wilsonActionOSPositive N T L β (U_ext cfg) +\n2670 |         wilsonActionOSNegative N T L β (U_ext cfg) +\n2671 |         wilsonActionOSInterface N T L β (U_ext cfg) := by\n2672 |     intro cfg\n2673 |     calc\n2674 |       S_total cfg = wilsonActionFinite N β (Finset.univ : Finset (PeriodicSite T L)) (U_ext cfg) := rfl\n2675 |       _ = wilsonActionOSPositive N T L β (U_ext cfg) +\n2676 |           wilsonActionOSNegative N T L β (U_ext cfg) +\n2677 |           wilsonActionOSInterface N T L β (U_ext cfg) :=\n2678 |         total_decomposition_os_periodic N T L β (U_ext cfg)\n2679 |   have h_neg_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2680 |       wilsonActionOSNegative N T L β (U_ext cfg) =\n2681 |       wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg)) := by\n2682 |     intro cfg\n2683 |     exact neg_action_reflection_os_periodic N T L β hT (U_ext cfg)\n2684 |   have h_int_reflect : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2685 |       wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) =\n2686 |       wilsonActionOSInterface N T L β (U_ext cfg) := by\n2687 |     intro cfg\n2688 |     exact interface_action_reflection_symmetric_os_periodic N T L β hT (U_ext cfg)\n2689 |   have h_factorization : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2690 |       Real.exp (-β * S_total cfg) = \n2691 |       (Real.exp (-β * wilsonActionOSPositive N T L β (U_ext cfg)) *\n2692 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) *\n2693 |       (Real.exp (-β * wilsonActionOSPositive N T L β (reflectLinkVariable N (U_ext cfg))) *\n2694 |         Real.exp (-β * wilsonActionOSInterface N T L β (reflectLinkVariable N (U_ext cfg)) / 2)) := by\n2695 |     intro cfg\n2696 |     rw [h_total_decomp cfg]\n2697 |     have h_mul : -β * (wilsonActionOSPositive N T L β (U_ext cfg) + wilsonActionOSNegative N T L β (U_ext cfg) +\n2698 |       wilsonActionOSInterface N T L β (U_ext cfg)) = \n2699 |       (-β * wilsonActionOSPositive N T L β (U_ext cfg)) + \n2700 |       (-β * wilsonActionOSNegative N T L β (U_ext cfg)) + \n2701 |       (-β * wilsonActionOSInterface N T L β (U_ext cfg)) := by ring\n2702 |     rw [h_mul]\n2703 |     rw [Real.exp_add, Real.exp_add]\n2704 |     rw [h_neg_reflect cfg, h_int_reflect cfg]\n2705 |     have h_exp_split : Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n2706 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n2707 |       Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by\n2708 |       calc\n2709 |         Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg)) =\n2710 |           Real.exp ((-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) +\n2711 |                    (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2)) := by ring\n2712 |         _ = Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) *\n2713 |             Real.exp (-β * wilsonActionOSInterface N T L β (U_ext cfg) / 2) := by rw [Real.exp_add]\n2714 |     rw [h_exp_split]\n2715 |     ring\n2716 |   set G := osG N T L β f with hG\n2717 |   have h_integrand_eq : ∀ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2718 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) *\n2719 |       Real.exp (-β * S_total cfg) =\n2720 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) := by\n2721 |     intro cfg\n2722 |     dsimp [G, osG]\n2723 |     rw [h_factorization cfg]\n2724 |     ring\n2725 |   have h_fun_eq : (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n2726 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg)) =\n2727 |     (λ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n2728 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg))) := by\n2729 |     ext cfg; exact h_integrand_eq cfg\n2730 |   calc\n2731 |     (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2732 |       f (U_ext cfg) * f (reflectLinkVariable N (U_ext cfg)) * Real.exp (-β * S_total cfg) ∂ μ₀)\n2733 |         = (∫ (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))),\n2734 |       G (U_ext cfg) * G (reflectLinkVariable N (U_ext cfg)) ∂ μ₀) := by\n2735 |       rw [h_fun_eq]\n2736 |     _ ≥ 0 := by\n2737 |       -- GOAL: Prove that ∫ G(U)·G(θU) dμ₀(U) ≥ 0.\n2738 |       -- The positivity follows from `transferMatrixPositivity_axiom`, which is\n2739 |       -- justified by `plaquetteBoltzmannPD` (Peter-Weyl / Clebsch-Gordan) ⟹\n2740 |       -- transfer matrix T positive ⟹ ∫ G·G(θU) ≥ 0.  See the axiom's docstring.\n2741 |       exact transferMatrixPositivity_axiom N T L β hT f hf_supported\n2742 | \n2743 | /-! ## Clean factorization and the PD-structure obstruction\n2744 | \n2745 | The reflection-positivity integrand `osG(U) · osG(θU)` factorizes cleanly as\n2746 | `f(U) · f(θU) · exp(-β S_W(U))` (lemma `osG_thetaG_factorization` below).\n2747 | This shows that the axiom `transferMatrixPositivity_axiom` is equivalent to:\n2748 | \n2749 |     ∫ f(U) · f(θU) · exp(-β S_W(U)) dμ₀ ≥ 0\n2750 | \n2751 | where `exp(-β S_W)` is the full Boltzmann factor, proved positive-definite on the\n2752 | full link-variable group by `boltzmannFactorPD` (in `BoltzmannFactor.lean`).\n2753 | \n2754 | **Key obstruction**: this integral is NOT the standard positive-definite quadratic\n2755 | form `∫∫ f(g) conj(f(h)) K(g⁻¹ h) dμ dμ ≥ 0` (which follows from PD-ness of `K`).\n2756 | Instead, it is a *single* integral `∫ f(g) f(θg) K(g) dμ` with the geometric\n2757 | reflection `θ` and `K` evaluated at `g` (not `g⁻¹ h`).  PD-ness of `K` on the\n2758 | group does NOT imply this integral is non-negative; the Peter–Weyl character\n2759 | expansion of `K` and character orthogonality are needed to decompose the\n\n... 188 more line(s) below (use offset=2760 to continue reading)\nTime: 2026-08-10 00:42:00 UTC","timestamp":1786322520,"token_count":2822,"tool_call_id":"b08978f7-b167-437e-916d-617558311317","full_token_estimate":1858,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/ReflectionPositivity.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":2947,"byte_count":172452,"is_error":false,"duration_ms":1,"edit_line":null},"turn":14,"is_prune_marker":false}
