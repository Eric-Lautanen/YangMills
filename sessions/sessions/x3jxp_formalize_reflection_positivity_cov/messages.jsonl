{"id":38,"role":"Tool","content":"C:\\github\\YangMills\\src\\lean\\YangMills\\Proofs\\TransferMatrix.lean\n-- 6055 lines, 297949 bytes --\n620 |   let K : TopologicalSpace.PositiveCompacts (SU N) :=\n621 |     ⟨⟨Set.univ, isCompact_univ⟩, by simpa using Set.univ_nonempty (α := SU N)⟩\n622 |   let haar := Measure.haarMeasure K\n623 |   have h1 : MeasurePreserving (MeasurableEquiv.sumPiEquivProdPi (fun _ => SU N)).symm\n624 |       ((Measure.pi (fun _ : FiniteLinkIndex Λ s₁ => haar)).prod\n625 |        (Measure.pi (fun _ : FiniteLinkIndex Λ s₂ => haar)))\n626 |       (Measure.pi (fun _ : FiniteLinkIndex Λ s₁ ⊕ FiniteLinkIndex Λ s₂ => haar)) :=\n627 |     measurePreserving_sumPiEquivProdPi_symm (fun _ => haar)\n628 |   have h2 : MeasurePreserving\n629 |       (MeasurableEquiv.arrowCongr' (finiteLinkIndexUnionSum h) (MeasurableEquiv.refl (SU N)))\n630 |       (Measure.pi (fun _ : FiniteLinkIndex Λ (s₁ ∪ s₂) => haar))\n631 |       (Measure.pi (fun _ : FiniteLinkIndex Λ s₁ ⊕ FiniteLinkIndex Λ s₂ => haar)) :=\n632 |     measurePreserving_arrowCongr' (fun _ => haar) (fun _ => haar)\n633 |       (finiteLinkIndexUnionSum h) (MeasurableEquiv.refl (SU N))\n634 |       (fun _ => MeasurePreserving.id haar)\n635 |   exact h1.trans h2.symm\n636 | \n637 | /-- The action of `productHaarMeasureUnionEquiv`: it splits a configuration on `s₁ ∪ s₂`\n638 | into the two components according to which set the site lies in. -/\n639 | lemma productHaarMeasureUnionEquiv_apply {Λ : Type} [DecidableEq Λ] {s₁ s₂ : Finset Λ}\n640 |     (h : Disjoint s₁ s₂) (cfg₁ : FiniteLinkConfig N Λ s₁) (cfg₂ : FiniteLinkConfig N Λ s₂)\n641 |     (idx : FiniteLinkIndex Λ (s₁ ∪ s₂)) :\n642 |     productHaarMeasureUnionEquiv N h (cfg₁, cfg₂) idx =\n643 |       if h₁ : idx.1.1 ∈ s₁ then cfg₁ ⟨idx.1, h₁⟩\n644 |       else cfg₂ ⟨idx.1, by\n645 |         rcases Finset.mem_union.mp idx.2 with h | h\n646 |         · exact absurd h h₁\n647 |         · exact h⟩ := by\n648 |   unfold productHaarMeasureUnionEquiv\n649 |   si