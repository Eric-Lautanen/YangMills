terface N T L x.1 x.2) := by\n5023 |     intro x\n5024 |     set m := mergePosInterface N T L x.1 x.2\n5025 |     -- Pointwise identity: for each Uneg, H (e (rho.symm (x, Uneg))) factors as g(m) * bracket\n5026 |     have hpt : ∀ (Uneg : FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)),\n5027 |         H (e (rho.symm (x, Uneg))) =\n5028 |         g_posInterface N T L hT β f m *\n5029 |           (g_posInterface N T L hT β f (reflectToPosInterface N T L Uneg (restrictToInterface N T L m)) *\n5030 |             Real.exp (-β * (osPositiveOfPosInterface N T L β m / 2 +\n5031 |               wilsonActionOSNegative N T L β (extendToFullConfig N T L Uneg m) / 2 +\n5032 |               wilsonActionOSInterface N T L β (extendToFullConfig N T L Uneg m)))) := by\n5033 |       intro Uneg\n5034 |       set U := extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n5035 |         (e (rho.symm (x, Uneg)))\n5036 |       -- restrict univ U = e (rho.symm (x, Uneg))  (extend then restrict = identity)\n5037 |       have h_ru : restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U =\n5038 |           e (rho.symm (x, Uneg)) := by\n5039 |         funext idx\n5040 |         obtain ⟨⟨n, μ⟩, hn⟩ := idx\n5041 |         simp only [restrictLinkVariable, extendLinkVariable, U, dif_pos (Finset.mem_univ n)]\n5042 |       -- restrictPosInterface (restrict univ U) = m  (via hRestrict and rho.symm structure)\n5043 |       have h_rpi : restrictPosInterface N T L\n5044 |           (restrictLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) U) = m := by\n5045 |         rw [h_ru, hRestrict (rho.symm (x, Uneg))]; rfl\n5046 |       -- restrict neg U = Uneg  (via hNeg and rho.symm structure)\n5047 |       have h_rn : restrictLinkVariable N (PeriodicSite T L) (negativeSites T L) U = Uneg := by\n5048 |         funext idx\n5049 |         obtain ⟨⟨n, μ⟩, hn⟩ := idx\n5050 |         simp only [restrictLinkVariable, extendLinkVariable, U, dif_pos (Finset.mem_univ n)]\n5051 |         rw [hNeg (rho.symm (x, Uneg)) ⟨(n, μ), hn⟩]\n5052 |         rfl\n5053 |       -- Unfold H to G U * G(θU), then apply the factorization and substitute\n5054 |       rw [show H (e (rho.symm (x, Uneg))) =\n5055 |           G N T L hT β f U * G N T L hT β f (reflectLinkVariable N U) from rfl]\n\n... 787 more line(s) below (use offset=5056 to continue reading)\nTime: 2026-08-06 04:19:58 UTC","timestamp":1785989998,"token_count":2584,"tool_call_id":"030cf8cc-f081-48cb-998c-137cbab783b8","full_token_estimate":1704,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/TransferMatrix.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":5842,"byte_count":284762,"is_error":false,"duration_ms":0,"edit_line":null},"turn":15,"is_prune_marker":false}
