rMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n4970 |   set H := fun (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n4971 |     G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n4972 |     G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n4973 |   -- Finiteness instances for the product Haar measures (needed for prod operations)\n4974 |   haveI hfinP : IsFiniteMeasure muP :=\n4975 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (positiveSites T L)\n4976 |   haveI hfinN : IsFiniteMeasure muN :=\n4977 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (negativeSites T L)\n4978 |   haveI hfinI : IsFiniteMeasure muI :=\n4979 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (interfaceSites T L)\n4980 |   -- Disjointness of positive and interface sites\n4981 |   have hpi : Disjoint (positiveSites T L) (interfaceSites T L) := by\n4982 |     unfold positiveSites interfaceSites\n4983 |     rw [Finset.disjoint_filter]; intro n hn hpos hzero; linarith\n4984 |   -- Reassociation equiv rho : (Pos × (Neg × Int)) ≃ᵐ ((Pos × Int) × Neg)\n4985 |   let rho : (FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n4986 |            (FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L) ×\n4987 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L))) ≃ᵐ\n4988 |           ((FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n4989 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) ×\n4990 |            FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) :=\n4991 |     (MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm).trans\n4992 |       MeasurableEquiv.prodAssoc.symm\n4993 |   have hMPrho : MeasurePreserving rho (muP.prod (muN.prod muI)) ((muP.prod muI).prod