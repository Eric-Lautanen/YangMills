rMeasure N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))\n4810 |   set H := fun (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) =>\n4811 |     G N T L hT β f (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg) *\n4812 |     G N T L hT β f (reflectLinkVariable N (extendLinkVariable N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L)) cfg))\n4813 |   -- Finiteness instances for the product Haar measures (needed for prod operations)\n4814 |   haveI hfinP : IsFiniteMeasure muP :=\n4815 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (positiveSites T L)\n4816 |   haveI hfinN : IsFiniteMeasure muN :=\n4817 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (negativeSites T L)\n4818 |   haveI hfinI : IsFiniteMeasure muI :=\n4819 |     productHaarMeasure_isFiniteMeasure N (PeriodicSite T L) (interfaceSites T L)\n4820 |   -- Disjointness of positive and interface sites\n4821 |   have hpi : Disjoint (positiveSites T L) (interfaceSites T L) := by\n4822 |     unfold positiveSites interfaceSites\n4823 |     rw [Finset.disjoint_filter]; intro n hn hpos hzero; linarith\n4824 |   -- Reassociation equiv rho : (Pos × (Neg × Int)) ≃ᵐ ((Pos × Int) × Neg)\n4825 |   let rho : (FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n4826 |            (FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L) ×\n4827 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L))) ≃ᵐ\n4828 |           ((FiniteLinkConfig N (PeriodicSite T L) (positiveSites T L) ×\n4829 |             FiniteLinkConfig N (PeriodicSite T L) (interfaceSites T L)) ×\n4830 |            FiniteLinkConfig N (PeriodicSite T L) (negativeSites T L)) :=\n4831 |     (MeasurableEquiv.prodCongr (MeasurableEquiv.refl _) MeasurableEquiv.prodComm).trans\n4832 |       MeasurableEquiv.prodAssoc.symm\n4833 |   have hMPrho : MeasurePreserving rho (muP.prod (muN.prod muI)) ((muP.prod muI).prod