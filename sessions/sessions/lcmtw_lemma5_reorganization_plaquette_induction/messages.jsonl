ared to G) ensures that G(U)·G(θU) factorizes as\n1324 | \n1325 |   g(U⁺,U⁰)·g(θ⁻⁰(U⁻,U⁰))·exp(-β·(S_OS⁻(U⁻)+S_OS_int(U))/2). -/\n1326 | \n1327 | noncomputable def g_posInterface (N T L : ℕ) [NeZero T] [NeZero L] (hT : Odd T) (β : ℝ)\n1328 | \n1329 |     (f : LinkVariable (SU N) (PeriodicSite T L) → ℝ)\n1330 | \n1331 |     (u : PosInterfaceConfig N T L) : ℝ :=\n1332 | \n1333 |   f (extendLinkVariable N (PeriodicSite T L) (positiveSites T L ∪ interfaceSites T L) u) *\n1334 | \n1335 |     Real.exp (-β * osPositiveOfPosInterface N T L β u / 2)\n1336 | \n1337 | \n1338 | \n1339 | /-- For a full config cfg, merging its restrictions to negative and pos+interface recovers cfg. -/\n1340 | \n1341 | lemma mergeConfigurations_restore (cfg : FiniteLinkConfig N (PeriodicSite T L) (Finset.univ : Finset (PeriodicSite T L))) :\n1342 | \n1343 |     mergeConfigurations N T L\n1344 | \n1345 |       (λ ⟨(n, μ), hn⟩ => cfg ⟨(n, μ), Finset.mem_univ n⟩)\n1346 | \n1347 |       (restrictPosInterface N T L cfg) = cfg := by\n1348 | \n1349 |   ext x\n\n... 4333 more line(s) below (use offset=1350 to continue reading)\nTime: 2026-08-05 05:28:43 UTC","timestamp":1785907723,"token_count":935,"tool_call_id":"2e246b78-85bd-4920-bfed-d7a615e7b69e","full_token_estimate":640,"tool_meta":{"tool_name":"read_file","file_path":"src/lean/YangMills/Proofs/TransferMatrix.lean","old_text":null,"new_text":null,"exit_code":null,"line_count":5682,"byte_count":275633,"is_error":false,"duration_ms":0,"edit_line":null},"turn":14,"is_prune_marker":false}
